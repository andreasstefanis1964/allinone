            },
            ".list-box": {
              "display": "flex",
              "flex-wrap": "wrap",
              "row-gap": "10px",
              "width": "100%",
              "margin-top": "30px"
            },
            ".list-item": {
              "display": "flex",
              "align-items": "center",
              "width": "100%",
              "column-gap": "12px"
            },
            ".iconfont-wrapper": {
              "flex-shrink": "0",
              ".mbr-iconfont": {
                "display": "block",
                "font-size": "25px",
                "color": "@iconColor",
                "transform": "rotate(-45deg)"
              }
            },
            ".list-text": {
              "flex-grow": "1",
              "color": "#131313"
            },
            ".mbr-section-btn": {
              "margin-top": "40px",
              "@media (max-width: 1500px)": {
                "margin-top": "15px"
              }
            }
