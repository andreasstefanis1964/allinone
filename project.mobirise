              }
            },
            ".mbr-section-btn .btn": {
              "padding": "10px 25px",
              "min-height": "48px"
            },
            ".border-item": {
              "position": "absolute",
              "bottom": "-1px",
              "display": "none",
              "width": "100%",
              "background-color": "transparent",
              "& when (@showBorder)": {
                "height": "2px",
                "background-color": "@borderColor"
              },
              "& when (@collapsed)": {
                "display": "block"
              },
              "@media (max-width: 991px)": {
                "display": "block"
              }
            },
            "& when (@collapsed)": {
              ".navbar.opened": {
                "& when (@transparent)": {
                  "background": "rgba(red(@menuBgColor), green(@menuBgColor), blue(@menuBgColor), @opacity) !important"
                }
              },
              ".navbar.navbar-short": {
                "background-color": "@menuBgColor !important"
              },
              ".navbar-collapse": {
                "position": "relative",
                "order": "5",
                "z-index": "5 !important",
                "padding-bottom": "10px"
              },
              ".border-item": {
                "position": "relative",
                "bottom": "0",
                "margin-top": "auto",
                "&:before": {
                  "content": "\"\"",
                  "position": "absolute",
                  "top": "100%",
                  "left": "50%",
                  "transform": "translate(-50%, 0)",
                  "width": "100vw",
                  "height": "100vw",
                  "background": "@menuBgColor",
                  "z-index": "4",
                  "transition": "0.1s all"
                }
              }
            },
            "@media (max-width: 991px)": {
              ".container, .container-fluid": {
                "min-height": "85px"
              },
              ".navbar-brand": {
                "min-height": "85px"
              },
              ".navbar-short": {
                ".container, .container-fluid": {
                  "min-height": "75px"
                },
                ".navbar-brand": {
                  "min-height": "75px !important"
                }
              },
              ".navbar.opened": {
                "& when (@transparent)": {
                  "background": "rgba(red(@menuBgColor), green(@menuBgColor), blue(@menuBgColor), @opacity) !important"
                }
              },
              ".navbar.navbar-short": {
                "background-color": "@menuBgColor !important"
              },
              ".navbar-collapse": {
                "position": "relative",
                "order": "5",
                "z-index": "5 !important",
                "padding-bottom": "10px"
              },
              ".navbar-nav": {
                ".nav-item": {
                  "display": "flex",
                  "justify-content": "flex-start",
                  "width": "100%"
                }
              },
              ".mbr-section-btn": {
                "text-align": "left"
              },
              ".border-item": {
                "position": "relative",
                "bottom": "0",
                "margin-top": "auto",
                "&:before": {
                  "content": "\"\"",
                  "position": "absolute",
                  "top": "100%",
                  "left": "50%",
                  "transform": "translate(-50%, 0)",
                  "width": "100vw",
                  "height": "100vw",
                  "background": "@menuBgColor",
                  "z-index": "4",
                  "transition": "0.1s all"
                }
              }
            }
          },
          "_name": "amenu1",
          "_sourceTheme": "calmm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"menu menu1 calmm5\" group=\"Menu\" plugins=\"DropDown, TouchSwipe\" always-top global once=\"menu\" not-draggable position-absolute>\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" name=\"fullWidth\" title=\"Full Width\" checked>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\" checked>\n        <input type=\"range\" title=\"Logo Size\" inline name=\"logoSize\" min=\"3\" max=\"8\" step=\"0.1\" value=\"3\" condition=\"showLogo\">\n        <input type=\"checkbox\" title=\"Brand Name\" name=\"showBrand\">\n        <input type=\"checkbox\" title=\"Menu Items\" name=\"showItems\" checked>\n        <input type=\"checkbox\" title=\"Button\" name=\"showButtons\" checked>\n        <input type=\"checkbox\" title=\"Border\" name=\"showBorder\" checked>\n        <input type=\"color\" title=\"Border Color\" name=\"borderColor\" value=\"#fc7942\" condition=\"showBorder\">\n        <header>Styles</header>\n        <input type=\"checkbox\" title=\"Sticky\" name=\"sticky\" checked>\n        <input type=\"checkbox\" title=\"Collapsed\" name=\"collapsed\">\n        <input type=\"checkbox\" title=\"Transparent\" name=\"transparent\">\n        <input type=\"range\" title=\"Opacity\" name=\"opacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0\" condition=\"transparent\">\n        <input type=\"color\" title=\"Color\" name=\"menuBgColor\" value=\"#ffffff\">\n        <input type=\"color\" title=\"Hamburger\" name=\"hamburgerColor\" value=\"#bbbbbb\">\n    </mbr-parameters>\n\n    <nav class=\"navbar navbar-dropdown\" mbr-class=\"{'navbar-fixed-top':sticky,\n                     'navbar-expand-lg':!collapsed,\n                     'collapsed':collapsed}\">\n        <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n            <div class=\"navbar-brand\">\n                <span mbr-if=\"showLogo\" class=\"navbar-logo\">\n                    <a href=\"https://all-in-one-digital-hotel.com\">\n                        <img src=\"@PROJECT_PATH@/assets/images/all-in-one-quer-transparent-557x117.webp\" alt=\"Mobirise Website Builder\" mbr-style=\"{'height': logoSize + 'rem'}\">\n                    </a>\n                </span>\n                <span mbr-if=\"showBrand\" mbr-buttons mbr-theme-style=\"display-5\" class=\"navbar-caption-wrap\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd,-mbrBtnRemove,-iconFont\"><a class=\"navbar-caption text-black\" data-app-selector=\".navbar-caption\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"></a></span>\n            </div>\n            <button class=\"navbar-toggler\" type=\"button\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-target=\"#navbarSupportedContent\" data-bs-target=\"#navbarSupportedContent\" aria-controls=\"navbarNavAltMarkup\" aria-expanded=\"false\" aria-label=\"Toggle navigation\" mbr-if=\"showItems || showIcons || showButtons\">\n                <div class=\"hamburger\">\n                    <span></span>\n                    <span></span>\n                    <span></span>\n                    <span></span>\n                </div>\n            </button>\n            <div class=\"collapse navbar-collapse\" id=\"navbarSupportedContent\" mbr-if=\"showItems || showIcons || showButtons\">\n                <ul mbr-menu class=\"navbar-nav nav-dropdown\" mbr-theme-style=\"display-7\" mbr-if=\"showItems\" mbr-class=\"{'nav-right': !showButtons,'navbar-nav-top-padding': isPublish && !showBrand && !showLogo}\"><li class=\"nav-item\"><a class=\"nav-link link text-black text-primary\" href=\"page9.html#aheader3-aq\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">BOOKING ENGINE</a>\n                    </li><li class=\"nav-item\"><a class=\"nav-link link text-black text-primary\" href=\"page7.html#header02-97\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">DEALS &amp; SHOP</a></li><li class=\"nav-item\"><a class=\"nav-link link text-black text-primary\" href=\"page6.html#header02-8l\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">ΣΥΝΔΡΟΜΕΣ</a></li><li class=\"nav-item\"><a class=\"nav-link link text-black text-primary\" href=\"cloud-pms-for-hotels-bnb-rentals.html#aheader3-3x\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">PMS</a></li><li class=\"nav-item\"><a class=\"nav-link link text-black text-primary\" href=\"Channel manager.html#aheader3-49\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">CHANNEL MANAGER</a></li><li class=\"nav-item\"><a class=\"nav-link link text-black text-primary\" href=\"websites.html#aheader3-3c\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">ΙΣΤΟΣΕΛΙΔΕΣ</a></li><li class=\"nav-item\"><a class=\"nav-link link text-black text-primary\" href=\"pms-for-multi-properties-bnb-administrators.html#aheader3-57\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">ΔΙΑΧΕΙΡΙΣΤΕΣ</a></li></ul>\n                <div mbr-if=\"showButtons\" mbr-buttons mbr-theme-style=\"display-7\" class=\"navbar-buttons mbr-section-btn\"><a class=\"btn btn-danger\" href=\"https://all-in-one-digital-hotel.de\" data-app-placeholder=\"Type Text\" target=\"_blank\">All in One Premium</a></div>\n            </div>\n            <div class=\"border-item\"></div>\n        </div>\n    </nav>\n</section>",
          "_cid": "vhfPpNRpiT",
          "_anchor": "amenu1-96",
          "_protectedParams": [],
          "_global": true,
          "_once": "menu",
          "_params": {}
        },
        {
          "_name": "header02",
          "_sourceTheme": "stockm5",
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".content-wrapper": {
              "display": "flex",
              "position": "relative",
              "padding": "60px",
              "@media (max-width: 992px)": {
                "padding": "30px 20px"
              },
              ".image-wrap": {
                "position": "absolute",
                "top": "0",
                "left": "0",
                "width": "100%",
                "height": "100%",
                "img": {
                  "position": "absolute",
                  "top": "0",
                  "left": "0",
                  "width": "100%",
                  "height": "100%",
                  "object-fit": "cover"
                }
              },
              "&::before": {
                "content": "''",
                "position": "absolute",
                "top": "0",
                "left": "0",
                "width": "100%",
                "height": "100%",
                "border-radius": "16px",
                "background-image": "linear-gradient(0.251turn, @imageColor 37%, transparent 100%)",
                "pointer-events": "none",
                "z-index": "1",
                "& when (@reverseContent)": {
                  "background-image": "linear-gradient(270deg, @imageColor 37%, transparent 100%)"
                }
              },
              ".content-wrap": {
                "position": "relative",
                "z-index": "2",
                "display": "inline-block",
                "width": "50%",
                "@media (max-width: 992px)": {
                  "width": "100%"
                },
                ".desc-wrapper": {
                  ".mbr-desc": {
                    "display": "inline-block",
                    "background-color": "@desc",
                    "padding": "8px 16px",
                    "margin-bottom": "32px"
                  }
                },
                ".mbr-section-title": {
                  "margin-bottom": "32px"
                },
                ".mbr-text": {
                  "margin-bottom": "0"
                },
                ".mbr-section-btn": {
                  "margin-top": "64px",
                  ".btn": {
                    "margin-bottom": "0"
                  }
                }
              }
            },
            ".mbr-section-title": {
              "color": "#404349"
            },
            ".mbr-text": {
              "color": "#404349"
            },
            ".mbr-desc": {
              "color": "#b19a7c"
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"header01 stockm5\" group=\"Headers\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Description\" name=\"showDesc\">\n        <input type=\"color\" title=\"Description BG\" value=\"#fff1e2\" name=\"desc\" condition=\"showDesc\" selected>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <input type=\"color\" title=\"Image Gradient Color\" value=\"#ff9466\" name=\"imageColor\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background1-2.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#fff1e2\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background1-2.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"content-wrapper\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n\t\t\t\t\t<div class=\"image-wrap\">\n\t\t\t\t\t\t<img src=\"@PROJECT_PATH@/assets/images/mbr-1920x960.webp\" alt>\n\t\t\t\t\t</div>\n                    <div class=\"content-wrap\">\n                        <div class=\"desc-wrapper\">\n                            <p class=\"mbr-desc mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showDesc\" data-app-selector=\".mbr-desc, .desc-wrapper\">\n\t\t\t\t\t\t\t\tService\n                            </p>\n                        </div>\n                        <h1 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle\">\n                            <b>Deals<br>All in One προσφορές</b></h1>\n                        <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">Με σκοπό την μείωση κόστους στην διαχείριση των online κρατήσεων δημιουργήσαμε ειδικές προσφορές για μεγαλύτερη ευελιξία και αύξηση κερδών.\n                        </p>\n                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-success\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                <span class=\"mobi-mbri mobi-mbri-right mbr-iconfont mbr-iconfont-btn\"></span>Startangebote</a></div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_isUserblock": true,
          "_cid": "vhfPpOEGVy",
          "_anchor": "header02-97",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "pricing01",
          "_sourceTheme": "rebootm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"pricing01 rebootm5\" group=\"Pricing\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Label\" name=\"showLabel\" checked>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\">\n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Icon\" name=\"showIcon\" checked>\n        <input type=\"color\" title=\"Icon Bg\" value=\"#ff9466\" name=\"iconBg\" condition=\"showIcon\" selected>\n        <input type=\"checkbox\" title=\"Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showCardText\" checked>\n        <input type=\"checkbox\" title=\"List\" name=\"showList\" checked>\n        <input type=\"checkbox\" title=\"Label\" name=\"showDesc\" condition=\"showList\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showCardButtons\" checked>\n        <input type=\"color\" title=\"BG 1\" value=\"#2b2b2b\" name=\"cardBg_1\" selected>\n        <input type=\"color\" title=\"BG 2\" value=\"#f9652f\" name=\"cardBg_2\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/rebootm5/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#3370a3\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/rebootm5/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#121212\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.4\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-lg-10\">\n                <div class=\"title-wrapper\">\n                    <p class=\"mbr-label mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-label\" mbr-if=\"showLabel\">ΙΣΧΥΕΙ ΑΝΑ VACATION RENTAL / BnB ANA MHNA ΛΕΙΤΟΥΡΓΙΑΣ ΜΕΧΡΙ 15.05.2026</p>\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .main-btn\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">Hot Deal για βίλες, διαμερίσματα, BnB</h2>\n                    <div class=\"text-wrapper\">\n                        <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .text-wrapper\">\n                            Achieve your fitness goals with professional guidance tailored to your lifestyle, body,\n                            and ambitions.\n                        </p>\n                    </div>\n                </div>\n                <div class=\"content-wrapper\">\n                    <div class=\"row items-wrapper justify-content-center\">\n                        <div class=\"col-12 col-lg-4 item features-without-image\">\n                            <div class=\"item-wrapper\">\n                                <div class=\"card-box\">\n                                    <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                        <span mbr-icon class=\"card-icon mbr-iconfont icon54-v1-hot-offer\" data-app-selector=\".card-icon\" style=\"color: rgb(255, 255, 255); fill: rgb(255, 255, 255);\"></span>\n                                    </div>\n                                    <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title, .iconfont-wrapper, .item-btn\">Light Deal VR/BnB</h4>\n                                    <p class=\"item-price mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-price\">€ 10/μήνα + 5%*</p>\n                                    <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardText\" data-app-selector=\".item-text\">Το Light πακέτο είναι ιδανικό για παραθεριστικά καταλύματα που ψάχνουν μία ολοκληρωμένη και οικονομική λύση με πολύ χαμηλό μηνιαίο πάγιο και μία σταθερή προμήθεια* στον συνολικό τζίρο των κρατήσεων.</p>\n                                    <div class=\"list-wrapper\" mbr-if=\"showList\">\n                                        <p class=\"item-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showDesc\" data-app-selector=\".item-desc\">Περιλαμβάνει:\n                                        </p>\n                                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                                            <li class=\"item-wrap\">Δωρεάν σετάρισμα / εγκατάσταση</li><li class=\"item-wrap\">Λογισμικό διαχείρισης κρατήσεων (PMS) από ένα κεντρικό ημερολόγιο</li>\n                                            <li class=\"item-wrap\">Channel manager μέχρι 4 πόρταλ, όπως Booking, AirBnB, Expedia, Google (βλέπε λίστα <a href=\"Channel manager.html#afeatures4-a3\" class=\"text-primary\">εδώ</a>)</li>\n                                            <li class=\"item-wrap\">Μηχανή κρατήσεων για την ιστοσελίδα (Booking engine)</li>\n                                            <li class=\"item-wrap\">Δωρεάν σύνδεση με myDATA συμπερ. της έκδοσης παραστατικών</li>\n                                        </ul>\n                                    </div>\n                                </div>\n                                <div mbr-buttons mbr-theme-style=\"display-7\" class=\"mbr-section-btn item-btn\" mbr-if=\"showCardButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-primary\" href=\"mbrext://smart-cart?cmdsm=_cart&amount=10.00&item_name=LIGHT%20DEAL%20ALL%20IN%20ONE%20BNB&currency_code=EUR&dataShop=smartCart\" data-app-placeholder=\"Type Text\">\n                                        <span class=\"mobi-mbri mobi-mbri-right mbr-iconfont mbr-iconfont-btn\"></span>Online παραγγελία</a></div>\n                            </div>\n                        </div>\n                        <div class=\"col-12 col-lg-4 item features-without-image\">\n                            <div class=\"item-wrapper card_2\">\n                                <div class=\"card-box\">\n                                    <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                    <span mbr-icon class=\"card-icon mbr-iconfont icon54-v1-hot-offer\" data-app-selector=\".card-icon\" style=\"color: rgb(255, 255, 255); fill: rgb(255, 255, 255);\"></span>\n                                    </div>\n                                    <h4 class=\"item-title_2 mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title_2, .iconfont-wrapper, .item-btn\">\n                                        Standard Deal VR/BnB\n                                    </h4>\n                                    <p class=\"item-price_2 mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-price_2\">€ 15/μήνα&nbsp;+ 5%*</p>\n                                    <p class=\"item-text_2 mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardText\" data-app-selector=\".item-text_2\">Το Standard πακέτο έχει το Light και σας δίνει επιπλέον εργαλεία προβολής και προώθησης&nbsp;με πολύ χαμηλό μηνιαίο πάγιο και μία σταθερή προμήθεια* στον συνολικό τζίρο όλων των κρατήσεων.</p>\n                                    <div class=\"list-wrapper\" mbr-if=\"showList\">\n                                        <p class=\"item-desc_2 mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showDesc\" data-app-selector=\".item-desc_2\">Περιλαμβάνει επιπλέον:\n                                        </p>\n                                        <ul class=\"list_2 mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list_2, .item-wrap_2\" data-multiline mbr-article>\n                                            <li class=\"item-wrap_2\">3 πόρταλ (ΟΤΑ) με τα οποία έχετε συμβόλαια (βλέπε λίστα <a href=\"Channel manager.html#afeatures4-a3\" class=\"text-primary\">εδώ</a>)</li>\n                                            <li class=\"item-wrap_2\">Προβολή στα πόρταλ με 8% προμήθεια: https://ela-greece.com &amp; https://secret-deals-hotels.com</li>\n                                            <li class=\"item-wrap_2\">Τεχνική Υποστήριξη</li>\n                                            <li class=\"item-wrap_2\">Συμβουλευτική υποστήριξη</li>\n                                        </ul>\n                                    </div>\n                                </div>\n                                <div mbr-buttons mbr-theme-style=\"display-7\" class=\"mbr-section-btn item-btn\" mbr-if=\"showCardButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-black\" href=\"mbrext://smart-cart?cmdsm=_cart&amount=15.00&item_name=STANDARD%20DEAL%20ALL%20IN%20ONE%20BNB&currency_code=EUR&dataShop=smartCart\" data-app-placeholder=\"Type Text\">\n                                        <span class=\"mobi-mbri mobi-mbri-right mbr-iconfont mbr-iconfont-btn\"></span>\n                                        Online παραγγελία\n                                    </a></div>\n                            </div>\n                        </div>\n                        <div class=\"col-12 col-lg-4 item features-without-image\">\n                            <div class=\"item-wrapper\">\n                                <div class=\"card-box\">\n                                    <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                        <span mbr-icon class=\"card-icon mbr-iconfont icon54-v1-hot-offer\" data-app-selector=\".card-icon\" style=\"color: rgb(255, 255, 255); fill: rgb(255, 255, 255);\"></span>\n                                    </div>\n                                    <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title, .iconfont-wrapper, .item-btn\">\n                                        Premium Deal VR/BnB\n                                    </h4>\n                                    <p class=\"item-price mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-price\">€ 25/μήνα + 5%*</p>\n                                    <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardText\" data-app-selector=\".item-text\">\n                                        Το Premium πακέτο έχει το Standard με ένα μηνιαίο πάγιο και μία σταθερή προμήθεια* στον συνολικό τζίρο όλων των κρατήσεων.\n                                    </p>\n                                    <div class=\"list-wrapper\" mbr-if=\"showList\">\n                                        <p class=\"item-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showDesc\" data-app-selector=\".item-desc\">Περιλαμβάνει επιπλέον:\n                                        </p>\n                                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                                            <li class=\"item-wrap\">5 πόρταλ (ΟΤΑ) με τα οποία έχετε συμβόλαια (βλέπε λίστα <a href=\"Channel manager.html#afeatures4-a3\" class=\"text-primary\">εδώ</a>)</li>\n                                            <li class=\"item-wrap\">Κατασκευή ιστοσελίδας σε 2 γλώσσες (ελληνικά, αγγλικά) σε δικό σας domain</li>\n                                            <li class=\"item-wrap\">Δωρεάν πακέτο φιλοξενίας (Hosting)</li>\n                                            <li class=\"item-wrap\">Τεχνική υποστήριξη ιστοσελίδας</li>\n                                        </ul>\n                                    </div>\n                                </div>\n                                <div mbr-buttons mbr-theme-style=\"display-7\" class=\"mbr-section-btn item-btn\" mbr-if=\"showCardButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-primary\" href=\"mbrext://smart-cart?cmdsm=_cart&amount=25.00&item_name=PREMIUM%20DEAL%20ALL%20IN%20ONE%20BNB&currency_code=EUR&dataShop=smartCart\" data-app-placeholder=\"Type Text\">\n                                        <span class=\"mobi-mbri mobi-mbri-right mbr-iconfont mbr-iconfont-btn\"></span>\n                                        Online παραγγελία\n                                    </a></div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".title-wrapper": {
              "margin-bottom": "40px",
              ".mbr-label": {
                "margin-bottom": "12px"
              },
              ".mbr-section-title": {
                "margin-bottom": "12px"
              },
              ".text-wrapper": {
                ".mbr-text": {
                  "display": "inline-block",
                  "width": "50%",
                  "margin-bottom": "0",
                  "@media (max-width: 992px)": {
                    "width": "100%"
                  }
                }
              }
            },
            ".items-wrapper": {
              "margin": "0 -8px",
              ".item": {
                "margin-bottom": "16px",
                "padding": "0 8px",
                "@media (max-width: 992px)": {
                  "&:last-child": {
                    "margin-bottom": "0"
                  }
                },
                ".item-wrapper": {
                  "height": "100%",
                  "display": "flex",
                  "flex-direction": "column",
                  "justify-content": "space-between",
                  "background-color": "@cardBg_1",
                  "padding": "24px",
                  "@media (max-width: 992px)": {
                    "padding": "16px"
                  },
                  ".card-box": {
                    ".iconfont-wrapper": {
                      ".mbr-iconfont": {
                        "display": "inline-flex",
                        "font-size": "24px",
                        "padding": "8px",
                        "margin-bottom": "12px",
                        "background-color": "@iconBg"
                      }
                    },
                    ".item-title, .item-title_2": {
                      "margin-bottom": "12px"
                    },
                    ".item-price, .item-price_2": {
                      "margin-bottom": "12px"
                    },
                    ".item-text, .item-text_2": {
                      "margin-bottom": "0"
                    },
                    ".list-wrapper": {
                      "margin-top": "24px",
                      ".item-desc, .item-desc_2": {
                        "margin-bottom": "12px"
                      },
                      ".list, .list_2": {
                        "padding": "0",
                        "margin": "0",
                        "list-style-type": "none",
                        ".item-wrap, .item-wrap_2": {
                          "margin-bottom": "12px",
                          "padding-left": "24px",
                          "position": "relative",
                          "&:last-child": {
                            "margin-bottom": "0"
                          },
                          "&::before": {
                            "content": "'✓'",
                            "position": "absolute",
                            "top": "0",
                            "left": "0",
                            "font-size": "inherit",
                            "color": "inherit"
                          }
                        }
                      }
                    }
                  },
                  ".mbr-section-btn": {
                    "width": "100%",
                    "margin-top": "16px",
                    ".btn": {
                      "justify-content": "space-between",
                      "width": "100%",
                      "margin-bottom": "0"
                    }
                  }
                },
                ".card_2": {
                  "background-color": "@cardBg_2"
                }
              }
            },
            ".btn-wrapper": {
              "margin-top": "-2.5rem"
            },
            ".mbr-label": {
              "color": "#ffffff",
              "text-align": "center"
            },
            ".mbr-section-title": {
              "color": "#ffffff",
              "text-align": "center"
            },
            ".mbr-text, .text-wrapper": {
              "color": "#ffffff",
              "text-align": "center"
            },
            ".item-title": {
              "color": "#ffffff"
            },
            ".item-title_2": {
              "color": "#ffffff"
            },
            ".item-price": {
              "color": "#ffffff"
            },
            ".item-price_2": {
              "color": "#ffffff"
            },
            ".item-text": {
              "color": "#ffffff"
            },
            ".item-text_2": {
              "color": "#ffffff"
            },
            ".item-desc": {
              "color": "#ffffff"
            },
            ".item-desc_2": {
              "color": "#ffffff"
            },
            ".list": {
