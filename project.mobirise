            "img": {
              "width": "120px",
              "margin": "auto"
            },
            ".card": {
              "transition": "all 0.3s",
              "height": "fit-content",
              "padding": "1rem 0",
              "opacity": "0.7",
              "margin-bottom": "1rem",
              "&:hover": {
                "opacity": "0.9",
                "box-shadow": "0 10px 55px 5px rgba(137, 173, 255, 0.35)"
              }
