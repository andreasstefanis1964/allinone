            ".main-container": {
              "display": "flex",
              "align-items": "center",
              "padding": "3rem 0",
              "& when (@reverseContent)": {
                "flex-direction": "row-reverse"
              },
              "@media (max-width: 991px)": {
                "flex-wrap": "wrap"
              }
            },
            ".card-wrap": {
              "width": "50%",
              "@media (max-width: 991px)": {
