            },
            ".iconfont-wrapper": {
              "flex-shrink": "0",
              ".mbr-iconfont": {
                "display": "block",
                "font-size": "25px",
                "color": "@iconColor",
                "transform": "rotate(-45deg)"
              }
            },
            ".list-text": {
