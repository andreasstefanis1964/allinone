            ".card-wrapper": {
              "width": "~\"calc(100% - 14px)\"",
              "padding": "80px 40px 60px 40px",
              "margin": "0 auto",
              "border": "2px solid @cardBorder",
              "box-shadow": "4px 4px 0 @cardBorder",
              "background": "@cardBg",
              "transition": ".3s all",
              "@media (max-width: 1199px)": {
                "padding": "40px 30px"
              },
              "@media (min-width: 992px)": {
                "&:hover": {
                  "box-shadow": "none",
                  "transform": "translateY(-5px)"
                }
              }
            },
            ".iconfont-wrapper": {
