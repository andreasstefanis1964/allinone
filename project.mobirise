              },
              ".mbr-iconfont": {
                "display": "block",
                "font-size": "100px",
                "color": "@iconColor"
              }
            },
            ".card-title": {
              "color": "#131313"
            },
            ".card-text": {
              "margin-top": "10px",
              "color": "#131313",
              "text-align": "center"
            },
            ".card-link": {
              "margin-top": "30px",
              "color": "#131313",
              "@media (max-width: 1199px)": {
                "margin-top": "20px"
              },
              "@media (max-width: 767px)": {
                "margin-top": "15px"
              },
              "a.text-primary": {
                "&:hover": {
                  "color": "#131313 !important"
                }
              }
            },
            ".card-title, .iconfont-wrapper": {
              "text-align": "center"
            }
