            "z-index": "1"
          },
          "_name": "eb-shop",
          "_sourceTheme": "calmm5",
          "_customHTML": "<section class=\"eb-shop\" group=\"Widget\">[JS_CODE_0]\n<div class=\"electricblaze-id-2UhxAwf\"></div></section>",
          "_cid": "vioN4zUhoG",
          "_anchor": "eb-shop-ao",
          "safe": {
            "id": 21237,
            "code": "<script src=\"https://s.electricblaze.com/widget.js\" defer></script>\n<div class=\"electricblaze-id-2UhxAwf\"></div>"
