          "_name": "afeatures1",
          "_sourceTheme": "charitym5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features1 charitym5\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"2\">\n        <select title=\"Align\" name=\"contentAlign\">\n            <option value=\"justify-content-start\" selected>Left</option>\n            <option value=\"justify-content-center\">Center</option>\n            <option value=\"justify-content-end\">Right</option>\n        </select>\n        <header>Show/Hide</header>\n        <input type=\"color\" title=\"Icon Color\" name=\"iconColor\" value=\"#9b8db7\" selected>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <select title=\"Cards\" name=\"cardsAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n            <option value=\"5\">5</option>\n            <option value=\"6\" selected>6</option>\n        </select>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#f6f6f6\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#f6f6f6\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div class=\"container\">\n        <div class=\"row {{contentAlign}} cards-row\">\n\n            <div class=\"card col-12 col-lg-4\">\n                <div class=\"card-wrapper\">\n                    <span mbr-icon class=\"mbr-iconfont icon54-v3-book-euro\" style=\"color: rgb(252, 121, 66); fill: rgb(252, 121, 66);\"></span>\n                    <div class=\"card-box\" mbr-if=\"showTitle || showText\">\n                        <h4 class=\"card-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showTitle\" data-app-selector=\".card-title\"><b>Γρήγορη και πανεύκολη έκδοση παραστατικών</b></h4>\n                        <p class=\"card-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\">Εκδίδετε μόνο με ελάχιστα κλικ τιμολόγια, αποδείξεις, φόρο διαμονής, και άλλα παραστατικά. Η συμπλήρωση των στοιχείων των παραστατικών γίνεται αυτόματα.&nbsp;</p>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"card col-12 col-lg-4\" mbr-if=\"cardsAmount > 1\">\n                <div class=\"card-wrapper\">\n                    <span mbr-icon class=\"mbr-iconfont mobi-mbri-logout mobi-mbri\" style=\"color: rgb(252, 121, 66); fill: rgb(252, 121, 66);\"></span>\n                    <div class=\"card-box\" mbr-if=\"showTitle || showText\">\n                        <h4 class=\"card-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showTitle\" data-app-selector=\".card-title\"><b>Δωρεάν σύνδεση με myDATA</b></h4>\n                        <p class=\"card-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\">Εάν το επιθυμείτε συνδέουμε δωρεάν τον myDATA λογαριασμό σας απευθείας μέσα από το λογισμικό για την ηλεκτρονική μεταφορά των παραστατικών στην ΑΑΔΕ μέσω myDATA.</p>\n                    </div>\n                </div>\n            </div>\n            <div class=\"card col-12 col-lg-4\" mbr-if=\"cardsAmount > 2\">\n                <div class=\"card-wrapper\">\n                    <span mbr-icon class=\"mbr-iconfont imind-broom\" style=\"color: rgb(252, 121, 66); fill: rgb(252, 121, 66);\"></span>\n                    <div class=\"card-box\" mbr-if=\"showTitle || showText\">\n                        <h4 class=\"card-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showTitle\" data-app-selector=\".card-title\"><b>Πλάνο καθαριότητας</b></h4>\n                        <p class=\"card-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\">Κάνοντας χρήση του στοιχείου «Καθαριότητα &amp; συντήρηση», μπορείτε να βλέπετε και να διαχειρίζεστε την καθαριότητα και την κατάσταση των δωματίων σας ανά πάσα στιγμή (Γενικός καθαρισμός, Συντήρηση, Αλλαγή σεντονιών, πετσετών, φρεσκάρισμα).</p>\n                    </div>\n                </div>\n            </div>\n            <div class=\"card col-12 col-lg-4\" mbr-if=\"cardsAmount > 3\">\n                <div class=\"card-wrapper\">\n                    <span mbr-icon class=\"mbr-iconfont icon54-v1-qr-code\" style=\"color: rgb(252, 121, 66); fill: rgb(252, 121, 66);\"></span>\n                    <div class=\"card-box\" mbr-if=\"showTitle || showText\">\n                        <h4 class=\"card-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">\n                            <b>Ηλεκτρονικό check-in με QR code</b></h4>\n                        <p class=\"card-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\">Έχετε τη δυνατότητα να πραγματοποιήσετε ηλεκτρονικά το check-in των επισκεπτών σας. Με αυτόν τον τρόπο τα στοιχεία τους θα είναι πάντα ενημερωμένα στο λογισμικό, όπως επίσης και το αρχείο κίνησης.</p>\n                    </div>\n                </div>\n            </div>\n            <div class=\"card col-12 col-lg-4\" mbr-if=\"cardsAmount > 4\">\n                <div class=\"card-wrapper\">\n                    <span mbr-icon class=\"mbr-iconfont mobi-mbri-bulleted-list mobi-mbri\" style=\"color: rgb(252, 121, 66); fill: rgb(252, 121, 66);\"></span>\n                    <div class=\"card-box\" mbr-if=\"showTitle || showText\">\n                        <h4 class=\"card-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showTitle\" data-app-selector=\".card-title\"><b>Διαχείριση πολλαπλών τιμοκαταλόγων</b></h4>\n                        <p class=\"card-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\">Έχετε την δυνατότητα να καταχωρήσετε πολλαπλούς τιμοκαταλόγους με εποχιακές τιμές και πολλές επιπλέον παραμέτρους (ελάχιστη διαμονή,...).</p>\n                    </div>\n                </div>\n            </div>\n            <div class=\"card col-12 col-lg-4\" mbr-if=\"cardsAmount > 5\">\n                <div class=\"card-wrapper\">\n                    <span mbr-icon class=\"mbr-iconfont sli-people\" style=\"color: rgb(252, 121, 66); fill: rgb(252, 121, 66);\"></span>\n                    <div class=\"card-box\" mbr-if=\"showTitle || showText\">\n                        <h4 class=\"card-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showTitle\" data-app-selector=\".card-title\"><b>Λίστα επισκεπτών</b></h4>\n                        <p class=\"card-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\">Έχετε τη δυνατότητα να πραγματοποιήσετε αναζήτηση στους επισκέπτες σας, ακόμη και με στοιχεία που δεν απεικονίζονται στις στήλες του πίνακα, όπως π.χ. σχόλια κ.α. Μπορείτε να ταξινομήσετε βάση οποιαδήποτε στήλης της λίστας, κάνοντας κλικ πάνω στην ονομασία της. Με δεύτερο κλικ στην ίδια στήλη, αλλάζει η φορά ταξινόμησης από αύξουσα σε φθίνουσα.</p>\n                    </div>\n                </div>\n            </div>\n\n        </div>\n    </div>\n</section>",
          "_isUserblock": true,
          "_cid": "u2Y2V06F9i",
          "_anchor": "afeatures1-5a",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".cards-row": {
              "row-gap": "50px"
            },
            ".card-wrapper": {
              "display": "flex",
              "align-items": "flex-start",
              "width": "100%"
            },
            ".mbr-iconfont": {
              "font-size": "82px",
              "color": "@iconColor"
            },
            ".card-box": {
              "padding-left": "28px"
            },
            ".card-title": {
              "color": "#303030"
            },
            ".card-text": {
              "color": "#303030",
              "margin-top": "10px"
            }
          },
          "_name": "afeatures1",
          "_sourceTheme": "charitym5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features1 charitym5\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"2\">\n        <select title=\"Align\" name=\"contentAlign\">\n            <option value=\"justify-content-start\" selected>Left</option>\n            <option value=\"justify-content-center\">Center</option>\n            <option value=\"justify-content-end\">Right</option>\n        </select>\n        <header>Show/Hide</header>\n        <input type=\"color\" title=\"Icon Color\" name=\"iconColor\" value=\"#9b8db7\" selected>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <select title=\"Cards\" name=\"cardsAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n            <option value=\"5\">5</option>\n            <option value=\"6\" selected>6</option>\n        </select>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#f6f6f6\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#f6f6f6\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div class=\"container\">\n        <div class=\"row {{contentAlign}} cards-row\">\n\n            <div class=\"card col-12 col-lg-4\">\n                <div class=\"card-wrapper\">\n                    <span mbr-icon class=\"mbr-iconfont mobi-mbri-browse mobi-mbri\" style=\"color: rgb(252, 121, 66); fill: rgb(252, 121, 66);\"></span>\n                    <div class=\"card-box\" mbr-if=\"showTitle || showText\">\n                        <h4 class=\"card-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showTitle\" data-app-selector=\".card-title\"><b>Πληθώρα αναφορών sσε πραγματικό χρόνο</b></h4>\n                        <p class=\"card-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\">Στο μενού «Αναφορές» έχετε τη δυνατότητα να απεικονίσετε αναφορές, γραφήματα και στατιστικά για το κατάλυμα σας.</p>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"card col-12 col-lg-4\" mbr-if=\"cardsAmount > 1\">\n                <div class=\"card-wrapper\">\n                    <span mbr-icon class=\"mbr-iconfont mobi-mbri-database mobi-mbri\" style=\"color: rgb(252, 121, 66); fill: rgb(252, 121, 66);\"></span>\n                    <div class=\"card-box\" mbr-if=\"showTitle || showText\">\n                        <h4 class=\"card-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">\n                            <b>Ιστορικό ενεργειών</b></h4>\n                        <p class=\"card-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\">Το ιστορικό ενεργειών αφορά κρατήσεις, παραστατικά, τιμοκαταλόγους και προμηθευτές, ενέργειες στη λίστα χρηστών κ.α.</p>\n                    </div>\n                </div>\n            </div>\n            <div class=\"card col-12 col-lg-4\" mbr-if=\"cardsAmount > 2\">\n                <div class=\"card-wrapper\">\n                    <span mbr-icon class=\"mbr-iconfont mobi-mbri-layers mobi-mbri\" style=\"color: rgb(252, 121, 66); fill: rgb(252, 121, 66);\"></span>\n                    <div class=\"card-box\" mbr-if=\"showTitle || showText\">\n                        <h4 class=\"card-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showTitle\" data-app-selector=\".card-title\"><b>Μαζική επεξεργασία αλλαγών (Bulk edit)</b></h4>\n                        <p class=\"card-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\">Εάν θέλετε να μεταβάλετε παραμέτρους για πολλές ημερομηνίες ή και πολλά δωμάτια ταυτόχρονα, μπορείτε να το κάνετε γρήγορα μέσω του εργαλείου μαζικής επεξεργασίας.\n                        </p>\n                    </div>\n                </div>\n            </div>\n            <div class=\"card col-12 col-lg-4\" mbr-if=\"cardsAmount > 3\">\n                <div class=\"card-wrapper\">\n                    <span mbr-icon class=\"mbr-iconfont mobi-mbri-update mobi-mbri\" style=\"color: rgb(252, 121, 66); fill: rgb(252, 121, 66);\"></span>\n                    <div class=\"card-box\" mbr-if=\"showTitle || showText\">\n                        <h4 class=\"card-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showTitle\" data-app-selector=\".card-title\"><b>Ενσωματωμένος All in One Channel manager</b></h4>\n                        <p class=\"card-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\">Με τη χρήση του channel manager πραγματοποιείται άμεσος συγχρονισμός τόσο των συνδεμένων online καναλιών (Booking.com, Airbnb, Expedia κ.α.) αλλά και της μηχανής κρατήσεων της ιστοσελίδας του καταλύματος.</p>\n                    </div>\n                </div>\n            </div>\n            <div class=\"card col-12 col-lg-4\" mbr-if=\"cardsAmount > 4\">\n                <div class=\"card-wrapper\">\n                    <span mbr-icon class=\"mbr-iconfont mobi-mbri-to-local-drive mobi-mbri\" style=\"color: rgb(252, 121, 66); fill: rgb(252, 121, 66);\"></span>\n                    <div class=\"card-box\" mbr-if=\"showTitle || showText\">\n                        <h4 class=\"card-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showTitle\" data-app-selector=\".card-title\"><b>Λίστα κρατήσεων</b></h4>\n                        <p class=\"card-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\">Η λίστα κρατήσεων απεικονίζει όλες σας τις κρατήσεις συγκεντρωτικά σε ένα πίνακα. Έχετε τη δυνατότητα να πραγματοποιήσετε αναζήτηση στις κρατήσεις σας, ακόμη και με στοιχεία που δεν απεικονίζονται στις στήλες του πίνακα, όπως π.χ. αναγνωριστικό κράτησης, σχόλια κ.α.\n                        </p>\n                    </div>\n                </div>\n            </div>\n            <div class=\"card col-12 col-lg-4\" mbr-if=\"cardsAmount > 5\">\n                <div class=\"card-wrapper\">\n                    <span mbr-icon class=\"mbr-iconfont icon54-v2-share-with-group\" style=\"color: rgb(252, 121, 66); fill: rgb(252, 121, 66);\"></span>\n                    <div class=\"card-box\" mbr-if=\"showTitle || showText\">\n                        <h4 class=\"card-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showTitle\" data-app-selector=\".card-title\"><b>Ομαδική κράτηση</b></h4>\n                        <p class=\"card-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\">Με την χρήση της ομαδικής κράτησης έχετε την δυνατότητα να εισάγετε κρατήσεις γρήγορα σε πολλά δωμάτια ταυτόχρονα. .</p>\n                    </div>\n                </div>\n            </div>\n\n        </div>\n    </div>\n</section>",
          "_isUserblock": true,
          "_cid": "u2Y2V0jSqN",
          "_anchor": "afeatures1-5b",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "position": "relative",
            "margin-top": "-1px",
            "overflow": "hidden",
            ".section-border-item": {
              "background-color": "@borderColor",
              "&_center": {
                "@media (max-width: 991px)": {
                  "display": "none"
                }
              }
            },
            ".main-container": {
              "display": "flex",
              "align-items": "center",
              "padding": "3rem 0",
              "& when (@reverseContent)": {
                "flex-direction": "row-reverse"
              },
              "@media (max-width: 991px)": {
                "flex-wrap": "wrap"
              }
            },
            ".card-wrap": {
              "width": "50%",
              "@media (max-width: 991px)": {
                "width": "100%"
              }
            },
            ".card-box": {
              "width": "100%",
              "padding-right": "10vw",
              "& when (@reverseContent)": {
                "padding-right": "0",
                "padding-left": "10vw"
              },
              "@media (max-width: 991px)": {
                "max-width": "32rem",
                "margin-right": "auto",
                "padding-right": "0",
                "padding-left": "0",
                "padding-bottom": "3rem"
              },
              "@media (max-width: 767px)": {
                "max-width": "100%"
              }
            },
            ".card-title": {
              "color": "#FFF"
            },
            ".mbr-text": {
              "color": "#FFF",
              "margin-top": "1.5rem",
              "@media (max-width: 767px)": {
                "margin-top": "1.25rem"
              }
            },
            ".counter-container": {
              "margin-top": "2rem",
              "@media (max-width: 767px)": {
                "margin-top": "1.5rem"
              }
            },
            ".list": {
              "display": "flex",
              "flex-wrap": "wrap",
              "gap": "1rem",
              "padding": "8px 0"
            },
            ".list-item": {
              "display": "flex",
              "align-items": "center",
              "width": "100%"
            },
            ".iconfont-wrapper": {
              "display": "flex",
              "align-items": "center",
              "justify-content": "center",
              "padding": "5px",
              "margin-right": "1rem",
              "border-radius": "50%",
              "background-color": "@iconBgColor",
              ".mbr-iconfont": {
                "display": "block",
                "font-size": "12px",
                "color": "@iconColor"
              }
            },
            ".list-text": {
              "color": "#FFF",
              "flex-grow": "1"
            },
            ".mbr-section-btn": {
              "margin-top": "1.5rem",
              "@media (max-width: 767px)": {
                "margin-top": "1rem"
              }
            },
            ".image-wrapper": {
              "display": "flex",
              "align-items": "center",
              "justify-content": "center",
              "width": "50%",
              "padding-left": "2.5rem",
              "& when (@reverseContent)": {
                "padding-right": "2.5vw",
                "padding-left": "0"
              },
              "@media (max-width: 991px)": {
                "position": "relative",
                "width": "100%",
                "padding-right": "0",
                "padding-left": "0",
                "padding-top": "3rem",
                "& when (@showBorder)": {
                  "&:before": {
                    "content": "\"\"",
                    "position": "absolute",
                    "top": "0",
                    "left": "50%",
                    "transform": "translateX(-50%)",
                    "width": "100vw",
                    "height": "1px",
                    "background-color": "@borderColor"
                  }
                }
              }
            },
            ".img-box": {
              "display": "flex",
              "align-items": "center",
              "justify-content": "center",
              "width": "100%",
              "max-width": "38rem",
              "img": {
                "width": "100%",
                "object-fit": "cover"
              }
            }
          },
          "_name": "afeatures1",
          "_sourceTheme": "structurem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features1 structurem5\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\" plugins=\"mobirise-icons2\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Border\" name=\"showBorder\" checked>\n        <input type=\"color\" title=\"Border Color\" name=\"borderColor\" value=\"#fcdb42\" condition=\"showBorder\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"List\" name=\"showList\" checked>\n        <input type=\"range\" inline title=\"List Count\" name=\"listCount\" min=\"1\" max=\"6\" step=\"1\" value=\"6\" condition=\"showList\">\n        <input type=\"checkbox\" title=\"Icons\" name=\"showIcon\" checked condition=\"showList\">\n        <input type=\"color\" title=\"Icon Color\" name=\"iconColor\" value=\"#090f10\" selected condition=\"showList && showIcon\">\n        <input type=\"color\" title=\"Icon Bg Color\" name=\"iconBgColor\" value=\"#ef5311\" selected condition=\"showList && showIcon\">\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value parallax selected>\n            <input type=\"color\" title=\"Color\" value=\"#090f10\">\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#090f10\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div class=\"section-border-item section-border-item_top\" mbr-if=\"showBorder\"></div>\n    <div class=\"section-border-item section-border-item_center\" mbr-if=\"showBorder\"></div>\n    <div class=\"section-border-item section-border-item_bottom\" mbr-if=\"showBorder\"></div>\n    <div mbr-class=\"{'container-fluid':fullWidth, container:fullWidth==false}\">\n        <div class=\"main-container\">\n            <div class=\"card-wrap\">\n                <div class=\"card-box\" mbr-if=\"showTitle || showText || showList || showButtons\">\n                    <h4 class=\"card-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">Online Συνδρομές FLAT για διαχειριστές&nbsp;<b>πολλαπλών </b>τουριστικών καταλυμάτων σε διαφορετικές διευθύνσεις (με Online Deal -10%)</h4>\n                    <p class=\"mbr-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">Με την ολοκληρωμένη τεχνολογία All in One LIGHT μειώνετε τα κόστη, αυξάνετε τις κρατήσεις και διαχειρίζεστε με πανεύκολο τρόπο όλες τις κρατήσεις από όλες τις συσκευές σας. Εσείς επιλέγετε μόνο τον τρόπο που θέλετε να πληρώνετε την συνδρομή σας (FLAT, μηνιαία ή ετήσια).</p>\n                    <div class=\"counter-container\" mbr-if=\"showList\">\n                        <div class=\"list\">\n                            <div class=\"list-item\">\n                                <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                    <span mbr-icon class=\"mbr-iconfont mobi-mbri-success mobi-mbri\"></span>\n                                </div>\n                                <p class=\"list-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".list-text\">Εγκατάσταση (Setup) ανά ID με συνδέσεις (ΟΤΑ ή και ICAL)</p>\n                            </div>\n                            <div class=\"list-item\" mbr-if=\"listCount > 1\">\n                                <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                    <span mbr-icon class=\"mbr-iconfont mobi-mbri-success mobi-mbri\"></span>\n                                </div>\n                                <p class=\"list-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".list-text\">Cloud λογισμικό (PMS) και από κινητές συσκευές</p>\n                            </div>\n                            <div class=\"list-item\" mbr-if=\"listCount > 2\">\n                                <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                    <span mbr-icon class=\"mbr-iconfont mobi-mbri-success mobi-mbri\"></span>\n                                </div>\n                                <p class=\"list-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".list-text\">Ενσωματωμένος All in One Channel manager (2-way xml)</p>\n                            </div>\n                            <div class=\"list-item\" mbr-if=\"listCount > 3\">\n                                <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                    <span mbr-icon class=\"mbr-iconfont mobi-mbri-success mobi-mbri\"></span>\n                                </div>\n                                <p class=\"list-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".list-text\">ΔΩΡΕΑΝ σύνδεση με 4 πόρταλ (Booking, AirBnB, Expedia, ...)</p>\n                            </div>\n                            <div class=\"list-item\" mbr-if=\"listCount > 4\">\n                                <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                    <span mbr-icon class=\"mbr-iconfont mobi-mbri-success mobi-mbri\"></span>\n                                </div>\n                                <p class=\"list-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".list-text\">\n                                    ΔΩΡΕΑΝ μηχανή κρατήσεων με 3% προμήθεια\n                                </p>\n                            </div>\n                            <div class=\"list-item\" mbr-if=\"listCount > 5\">\n                                <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                    <span mbr-icon class=\"mbr-iconfont mobi-mbri-success mobi-mbri\"></span>\n                                </div>\n                                <p class=\"list-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".list-text\">ΔΩΡΕΑΝ σύνδεση με myDATA (ΑΑΔΕ)</p>\n                            </div>\n                        </div>\n                    </div>\n                    <div mbr-buttons mbr-theme-style=\"display-7\" class=\"mbr-section-btn mb-0\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-primary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                            <span class=\"mobi-mbri mobi-mbri-right mbr-iconfont mbr-iconfont-btn\"></span>\n                            Learn More About Our Services\n                        </a></div>\n                </div>\n            </div>\n            <div class=\"image-wrapper\">\n                <div class=\"img-box\">\n                    <img src=\"@PROJECT_PATH@/assets/images/mbr-1216x684.webp\" alt=\"Mobirise Website Builder\">\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_isUserblock": true,
