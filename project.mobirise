              }
            },
            ".card-box": {
              "width": "100%",
              "padding-right": "10vw",
              "& when (@reverseContent)": {
                "padding-right": "0",
                "padding-left": "10vw"
              },
              "@media (max-width: 991px)": {
                "max-width": "32rem",
                "margin-right": "auto",
                "padding-right": "0",
                "padding-left": "0",
                "padding-bottom": "3rem"
              },
              "@media (max-width: 767px)": {
                "max-width": "100%"
              }
            },
            ".card-title": {
              "color": "#FFF"
            },
            ".mbr-text": {
              "color": "#FFF",
              "margin-top": "1.5rem",
              "@media (max-width: 767px)": {
                "margin-top": "1.25rem"
              }
            },
            ".counter-container": {
              "margin-top": "2rem",
              "@media (max-width: 767px)": {
