          "_name": "afeatures1",
          "_sourceTheme": "calmm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features1 calmm5\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"5\">\n        <select title=\"Align\" name=\"contentAlign\">\n            <option value=\"justify-content-start\">Left</option>\n            <option value=\"justify-content-center\" selected>Center</option>\n            <option value=\"justify-content-end\">Right</option>\n        </select>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showMainTitle\">\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showMainSubtitle\">\n        <header>Card</header>\n        <input type=\"checkbox\" title=\"Icons\" name=\"showIcon\" checked>\n        <input type=\"color\" title=\"Icon Color\" name=\"iconColor\" value=\"#FC7942\" condition=\"showIcon\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Link\" name=\"showLink\">\n        <input type=\"color\" title=\"Card Bg\" name=\"cardBg\" value=\"#FFFFFF\">\n        <input type=\"color\" title=\"Card Border\" name=\"cardBorder\" value=\"#131313\">\n        <select title=\"Cards\" name=\"cardsAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\" selected>3</option>\n        </select>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background2.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@THEME_PATH@/components/_images/background2.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container-small': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12 mbr-section-head\" mbr-if=\"showMainTitle || showMainSubtitle\">\n                <h3 class=\"mbr-section-title mbr-fonts-style align-center mb-0\" mbr-theme-style=\"display-2\" mbr-if=\"showMainTitle\" data-app-selector=\".mbr-section-title\">\n                    <b>Our incredible services</b>\n                </h3>\n                <h5 class=\"mbr-section-subtitle mbr-fonts-style align-center mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showMainSubtitle\" data-app-selector=\".mbr-section-subtitle\">\n                    Suspendisse sed nisi lacus sed viverra tellus.\n                </h5>\n            </div>\n        </div>\n        <div class=\"row cards-row {{contentAlign}}\" mbr-if=\"showIcon  || showTitle || showText || showLink\">\n\n            <div class=\"card col-12 col-lg-4\">\n                <div class=\"card-wrapper\">\n                    <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                        <span mbr-icon class=\"mbr-iconfont mbri-left-right\"></span>\n                    </div>\n                    <h5 class=\"card-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showTitle\" data-app-selector=\".card-title, .iconfont-wrapper\"><b>2-way xml ή iCAL συνδέσεις</b></h5>\n                    <p class=\"card-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\">Όλες οι συνδέσεις και οι συγχρονισμοί δεδομένων με τα πόρταλ κρατήσεων γίνονται μέσα σε λίγα δευτερόλεπτα αμφίδρομα (2-way) μέσω xml και με 100% ασφαλείς διαδικασίες και πρωτόκολλα. Μπορούμε όμως να ενσωματώσουμε και iCAL ημερολόγια.</p>\n                    <p class=\"card-link mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showLink\" data-app-selector=\".card-link\">\n                        <a href=\"https://mobiri.se\" class=\"text-primary\">LEARN MORE</a>\n                    </p>\n                </div>\n            </div>\n\n            <div class=\"card col-12 col-lg-4\" mbr-if=\"cardsAmount > 1\">\n                <div class=\"card-wrapper\">\n                    <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                        <span mbr-icon class=\"mbr-iconfont mbri-users\"></span>\n                    </div>\n                    <h5 class=\"card-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showTitle\" data-app-selector=\".card-title, .iconfont-wrapper\"><b>Εξυπηρέτηση πελατών</b></h5>\n                    <p class=\"card-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\">Για οποιεσδήποτε τεχνικές, λειτουργικές ή συμβουλευτικές ερωτήσεις μπορείτε να επικοινωνήσετε μαζί μας μέσω του LIVE Chat με ένα κλικ μέσω WhatsApp ή Viber.</p>\n                    <p class=\"card-link mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showLink\" data-app-selector=\".card-link\">\n                        <a href=\"https://mobiri.se\" class=\"text-primary\">LEARN MORE</a>\n                    </p>\n                </div>\n            </div>\n            <div class=\"card col-12 col-lg-4\" mbr-if=\"cardsAmount > 2\">\n                <div class=\"card-wrapper\">\n                    <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                        <span mbr-icon class=\"mbr-iconfont mbri-like\"></span>\n                    </div>\n                    <h5 class=\"card-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showTitle\" data-app-selector=\".card-title, .iconfont-wrapper\"><b>1η εγκατάσταση (Setup)</b></h5>\n                    <p class=\"card-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\">Η ομάδα μας σετάρει όλα τα στοιχεία του ξενοδοχείου ή του καταλύματός σας σε όλα τα επίπεδα για να μην συμβούν λάθη στις συνδεσιμότητες. Επίσης εισάγουμε τις υπάρχουσες κρατήσεις στο λογισμικό.</p>\n                    <p class=\"card-link mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showLink\" data-app-selector=\".card-link\">\n                        <a href=\"https://mobiri.se\" class=\"text-primary\">LEARN MORE</a>\n                    </p>\n                </div>\n            </div>\n\n        </div>\n    </div>\n</section>",
          "_cid": "v8MLPkCi5G",
          "_anchor": "afeatures1-8z",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".row": {
              "margin": "0 !important",
              "& when (@reverseContent)": {
                "flex-direction": "row-reverse"
              }
            },
            ".mbr-section-head": {
              "width": "40%",
              "padding": "0 !important",
              "@media (max-width: 991px)": {
                "width": "100%",
                "margin-bottom": "50px"
              },
              "@media (max-width: 767px)": {
                "margin-bottom": "40px"
              }
            },
            ".mbr-section-title": {
              "color": "#131313",
              "margin-bottom": "0"
            },
            ".mbr-section-subtitle": {
              "color": "#131313",
              "margin-top": "20px",
              "@media (max-width: 767px)": {
                "margin-top": "10px"
              }
            },
            ".mbr-section-btn": {
              "margin-top": "30px",
              "@media (max-width: 767px)": {
                "margin-top": "10px"
              }
            },
            ".col-list": {
              "width": "1px",
              "flex-grow": "1",
              "padding": "0 0 0 100px !important",
              "& when (@reverseContent)": {
                "padding": "0 100px 0 0  !important"
              },
              "@media (max-width: 1024px)": {
                "padding": "0 0 0 20px !important",
                "& when (@reverseContent)": {
                  "padding": "0 20px 0 0  !important"
                }
              },
              "@media (max-width: 991px)": {
                "width": "100%",
                "padding": "0 !important"
              }
            },
            ".mbr-iconfont": {
              "position": "relative",
              "font-size": "16px !important",
              "font-family": "'Moririse2' !important",
              "font-weight": "900",
              "color": "@iconColor",
              "margin-left": "0.5rem"
            },
            ".sign-open": {
              "display": "none",
              "font-size": "16px !important",
              "margin-left": "0.5rem",
              "color": "@iconColor",
              "font-weight": "900"
            },
            ".panel-group": {
              "border": "none"
            },
            ".card": {
              "padding": "10px 10px 10px 0",
              "border-radius": "0",
              "border-top": "2px solid @borderColor"
            },
            ".card-header": {
              "padding": "0",
              "border": "none",
              "background-color": "transparent",
              "margin-bottom": "0",
              "&:hover": {
                ".mbr-iconfont": {
                  "transform": "rotate(180deg)"
                }
              }
            },
            ".panel-title": {
              "display": "flex",
              "align-items": "center",
              "justify-content": "space-between",
              "padding": "10px 0",
              "color": "#131313",
              "transition": ".2s all",
              "&[aria-expanded=\"true\"]": {
                ".mbr-iconfont": {
                  "display": "none"
                },
                ".sign-open": {
                  "display": "block"
                }
              }
            },
            ".panel-title-edit": {
              "color": "#131313"
            },
            ".panel-body": {
              "padding": "0 0 20px"
            },
            ".panel-text": {
              "color": "#131313",
              "margin": "0"
            }
          },
          "_name": "alist1",
          "_sourceTheme": "calmm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"list1 calmm5\" group=\"List\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background':bg.parallax}\" plugins=\"mbr-switch-arrow, mobirise-icons2\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <input type=\"color\" title=\"Border Color\" name=\"borderColor\" value=\"#131313\">\n        <input type=\"color\" title=\"Icon Color\" name=\"iconColor\" value=\"#000000\">\n        <select title=\"Amount\" name=\"cardAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n            <option value=\"5\">5</option>\n            <option value=\"6\" selected>6</option>\n        </select>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background2.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ff9466\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@THEME_PATH@/components/_images/background2.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#FFFFFF\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.9\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container-small': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"mbr-section-head\" mbr-if=\"showTitle || showSubtitle || showButtons\">\n                <h3 class=\"mbr-section-title mb-0 mbr-fonts-style\" mbr-theme-style=\"display-2\" data-app-selector=\".mbr-section-title\" mbr-if=\"showTitle\">\n                    <b>Συχνές ερωτήσεις (FAQ):</b></h3>\n                <h4 class=\"mbr-section-subtitle mb-0 mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-section-subtitle, .mbr-section-btn\" mbr-if=\"showSubtitle\">Εδώ θα διαβάσετε κάποιες βασικές πληροφορίες σχετικά με τα προϊόντα και τις υπηρεσίες του All in One, ώστε να έχετε μία σφαιρική εικόνα για ότι προσφέρουμε.\n                </h4>\n                <div class=\"mbr-section-btn\" mbr-if=\"showButtons\" mbr-buttons mbr-theme-style=\"display-7\"><a class=\"btn btn-primary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">ΔΙΑΒΑΣΤΕ ΤΙΣ ΑΠΑΝΤΗΣΕΙΣ</a></div>\n            </div>\n            <div class=\"col-list\">\n                <div id=\"bootstrap-accordion\" class=\"panel-group accordionStyles accordion\" role=\"tablist\" aria-multiselectable=\"true\">\n                    <div class=\"card\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingOne\">\n                            <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse1\" aria-expanded=\"false\" aria-controls=\"collapse1\">\n                                <h6 class=\"panel-title-edit mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-title-edit\">\n                                    <b>Ποιές τεχνολογίες περιλαμβάνει το βασικό πακέτο All in One;</b></h6>\n                                <span class=\"sign mbr-iconfont mobi-mbri-plus\"></span>\n                                <span class=\"sign-open\">—</span>\n                            </a>\n                        </div>\n                        <div id=\"collapse1\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingOne\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\">Το βασικό πακέτο και στις δύο εκδόσεις (LIGHT &amp; PREMIUM) περιλαμβάνει το ξενοδοχειακό λογισμικό (PMS) με 100% cloud διαχείριση από κινητές συσκευές, τον ενσωματωμένο All in One Channel manager (CM) με τις 2-way xml συνδέσεις στα πόρταλ Booking, AirBnB, Expedia καθώς επίσης και την μηχανή κρατήσεων (BE) για την ιστοσελίδα σας, η οποία είναι ιδανική και για κινητές συσκευές.</p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"cardAmount > 1\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingOne\">\n                            <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse2\" aria-expanded=\"false\" aria-controls=\"collapse2\">\n                                <h6 class=\"panel-title-edit mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-title-edit\"><b>Ποιά είναι τα πλεονεκτήματα του All in One LIGHT;</b></h6>\n                                <span class=\"sign mbr-iconfont mobi-mbri-plus\"></span>\n                                <span class=\"sign-open\">—</span>\n                            </a>\n                        </div>\n                        <div id=\"collapse2\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingOne\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\">Η έκδοση LIGHT είναι μία οικονομική ολοκληρωμένη τεχνολογία, με την οποία διαχειρίζεστε - και από το κινητό σας, από ένα κεντρικό ημερολόγιο όλες τις κρατήσεις σας. Έτσι δεν χρειάζεται να ψάχνετε για ξεχωριστές εφαρμογές, γιατί τα έχετε όλα σε μία. Ειδικά διαμορφωμένες συνδρομές (FLAT ή FLEX) σας δίνουν μεγάλη ευελιξία στην επιλογή του πακέτου που ταιριάει καλύτερα στην επιχείρησή σας.</p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"cardAmount > 2\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingOne\">\n                            <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse3\" aria-expanded=\"false\" aria-controls=\"collapse3\">\n                                <h6 class=\"panel-title-edit mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-title-edit\"><b>Πώς γίνεται η παραγγελία του All in One;</b></h6>\n                                <span class=\"sign mbr-iconfont mobi-mbri-plus\"></span>\n                                <span class=\"sign-open\">—</span>\n                            </a>\n                        </div>\n                        <div id=\"collapse3\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingOne\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\">Η παραγγελία της All in One μπορεί να γίνει α) με μία έκπτωση online ή β) μέσω γραπτής ανάθεσης. Οι πληρωμές των συνδρομών γίνονται με τους παρακάτω τρόπους: Μέσω πιστωτικών ή χρεωστικών καρτών, Paypal.\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"cardAmount > 3\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingOne\">\n                            <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse4\" aria-expanded=\"false\" aria-controls=\"collapse4\">\n                                <h6 class=\"panel-title-edit mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-title-edit\"><b>Πόσο διαρκεί η εγκατάσταση στο All in One;</b></h6>\n                                <span class=\"sign mbr-iconfont mobi-mbri-plus\"></span>\n                                <span class=\"sign-open\">—</span>\n                            </a>\n                        </div>\n                        <div id=\"collapse4\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingOne\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\">Από την στιγμή που θα μας έχετε στείλει όλα τα στοιχεία που χρειάζονται για το σετάρισμα του καταλύματός σας στο All in One (LIGHT ή PREMIUM), συνήθως ο χρόνος που απαιτείται είναι 2 έως και 7 εργάσιμες ημέρες.\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"cardAmount > 4\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingOne\">\n                            <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse5\" aria-expanded=\"false\" aria-controls=\"collapse5\">\n                                <h6 class=\"panel-title-edit mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-title-edit\"><b>Ποιές είναι οι χρεώσεις / συνδρομές για τo All in One;</b></h6>\n                                <span class=\"sign mbr-iconfont mobi-mbri-plus\"></span>\n                                <span class=\"sign-open\">—</span>\n                            </a>\n                        </div>\n                        <div id=\"collapse5\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingOne\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\">Οι συνδρομές για το βασικό πακέτο του All in One είναι α) είτε το πάγιο μοντέλο FLAT με μηνιαία ή ετήσια συνδρομή ή β) το ευέλικτο μοντέλο FLEX με χαμηλότερο πάγιο + κόμιστρο ανά επιβεβαιωμένη κράτηση με βάση τα check-in. Τις αντίστοιχες χρεώσεις μπορείτε να διαβάσετε παρακάτω στην σελίδα.\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"cardAmount > 5\">\n                        <div class=\"card-header\" role=\"tab\" id=\"headingOne\">\n                            <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse6\" aria-expanded=\"false\" aria-controls=\"collapse6\">\n                                <h6 class=\"panel-title-edit mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-title-edit\"><b>Ποιές άλλες τεχνολογίες προτείνετε;</b></h6>\n                                <span class=\"sign mbr-iconfont mobi-mbri-plus\"></span>\n                                <span class=\"sign-open\">—</span>\n                            </a>\n                        </div>\n                        <div id=\"collapse6\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingOne\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n                            <div class=\"panel-body\">\n                                <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\">Αποκτήστε με πολύ οικονομικό τρόπο (από € 20,00 ανά μήνα ενοικίαση) μία ιστοσελίδα με το μοντέλο \"<a href=\"websites.html#afeatures3-7a\" class=\"text-primary\">Rent a Website</a>\" με καινοτόμες ψηφιακές τεχνολογίες. Έτσι προσελκύετε απευθείας κρατήσεις και περισσότερους πελάτες. Επίσης προτείνουμε την χρήση τεχνολογίας υπολογισμού τιμών (Yielding) για να είσαστε πάντα ανταγωνιστικοί και να πετυχαίνετε υψηλότερες πληρότητες.</p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "v8MLPlcrSx",
          "_anchor": "alist1-90",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background": "linear-gradient(to bottom, @secondColor 0 40%, @bg-value 40% 100%)"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".container-fluid": {
              "@media (max-width: 1024px)": {
                "padding": "0 80px !important"
              },
              "@media (max-width: 991px)": {
                "padding": "0 40px !important"
              },
              "@media (max-width: 767px)": {
                "padding": "0 20px !important"
              }
            },
            "iframe, img, video": {
              "width": "100%"
            },
            ".mbr-section-head": {
              "margin-bottom": "80px",
              "@media (max-width: 1399px)": {
                "margin-bottom": "65px"
              },
              "@media (max-width: 767px)": {
                "margin-bottom": "30px"
              }
            },
            ".mbr-section-title": {
              "color": "#131313"
            },
            ".mbr-section-subtitle": {
              "margin-top": "18px",
              "color": "#131313"
            },
            ".mbr-media": {
              "position": "relative",
              "height": "100%",
              "max-height": "100vh",
              "img": {
                "width": "100%",
                "object-fit": "cover",
                "height": "100%"
              }
            },
            ".box": {
              "padding": "0 !important",
              "@media (max-width: 1199px)": {
                "height": "500px"
              },
              "@media (max-width: 767px)": {
                "height": "400px"
              },
              "@media (min-width: 1025px)": {
                "&:hover": {
                  ".icon-wrap": {
                    ".mbr-iconfont": {
                      "min-width": "120px",
                      "min-height": "120px"
                    }
                  }
                }
              }
            },
            ".icon-wrap": {
              "left": "50%",
              "top": "50%",
              "transform": "translate(-50%, -50%)",
              "position": "absolute",
              ".mbr-iconfont": {
                "display": "flex",
                "align-items": "center",
                "justify-content": "center",
                "min-width": "140px",
                "min-height": "140px",
                "padding": "20px",
                "background-color": "@iconBg",
                "border": "2px solid @iconColor",
                "color": "@iconColor",
                "font-size": "32px",
                "transition": ".3s all",
                "@media (max-width: 1024px)": {
                  "padding": "12px",
                  "min-width": "110px",
                  "min-height": "110px"
                },
                "@media (max-width: 767px)": {
                  "padding": "10px",
                  "min-width": "90px",
                  "min-height": "90px"
                },
                "&:hover": {
                  "@media (min-width: 1025px)": {
                    "min-width": "140px !important",
                    "min-height": "140px !important"
                  },
                  "color": "@iconBg",
                  "background-color": "@iconHoverColor"
                }
              }
            },
            ".mbr-media span": {
              "font-size": "4rem",
              "transition": "all 0.2s"
            },
            ".modalWindow": {
              "position": "fixed",
              "z-index": "5000",
              "left": "0",
              "top": "0",
              "background-color": "rgba(61, 61, 61, 0.65)",
              "height": "100%",
              "width": "100%",
              "@media (max-width: 767px)": {
                "width": "100vw",
                "height": "100vh"
              },
              ".modalWindow-container": {
                "display": "table-cell",
                "vertical-align": "middle"
              },
              ".modalWindow-video": {
                "height": "45vw",
                "width": "80vw",
                "margin": "0 auto"
              }
            },
            ".close": {
              "position": "fixed",
              "opacity": "0.5",
              "font-size": "22px",
              "font-weight": "300",
              "width": "60px",
              "height": "60px",
              "border-radius": "50%",
              "color": "#fff",
              "top": "2.5rem",
              "right": "2.5rem",
              "border": "2px solid #fff",
              "text-shadow": "none",
              "z-index": "5",
              "transition": "opacity 0.3s ease",
              "align-items": "center",
              "justify-content": "center",
              "display": "flex",
              "&:hover": {
                "opacity": "1",
                "background": "#000",
                "color": "#fff"
              }
            }
          },
          "_name": "avideo1",
          "_sourceTheme": "calmm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"video1 calmm5\" group=\"Images & Videos\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" plugins=\"PlayerVimeo\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" name=\"fullWidth\" title=\"Full Width\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" name=\"textWidth\" title=\"Video\" min=\"4\" max=\"12\" step=\"1\" value=\"12\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n        <input type=\"color\" title=\"Icon Color\" name=\"iconColor\" value=\"#131313\">\n        <input type=\"color\" title=\"Icon BG Color\" name=\"iconBg\" value=\"#FFFFFF\">\n        <input type=\"color\" title=\"Icon Hover Color\" name=\"iconHoverColor\" value=\"#ff9466\">\n        <header>Video</header>\n        <input type=\"text\" title=\"Link\" name=\"modalVideo\" value=\"https://youtu.be/96smWZ-_MTw\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input title=\"Image\" type=\"image\" value=\"@PROJECT_PATH@/assets/images/background1.webp\">\n            <input title=\"Color\" type=\"color\" value=\"#FFFFFF\" selected>\n            <input title=\"Video\" type=\"video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <input type=\"color\" title=\"Second Color\" name=\"secondColor\" value=\"#FC7942\" condition=\"bg.type == 'color'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#FFFFFF\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.4\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"mbr-section-head\" mbr-if=\"showTitle || showSubtitle\">\n            <h4 class=\"mbr-section-title mbr-fonts-style align-center mb-0\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">Δείτε εδώ ένα περιληπτικό βίντεο</h4>\n            <h5 class=\"mbr-section-subtitle mbr-fonts-style align-center mb-0\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-4\" mbr-if=\"showSubtitle\">\n                Libero volutpat sed cras ornare arcu dui vivamus arcu felis.\n            </h5>\n        </div>\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-lg-{{textWidth}}\">\n                <div class=\"box\">\n                    <div class=\"mbr-media show-modal align-center\" data-modal=\".modalWindow\">\n                        <img src=\"@PROJECT_PATH@/assets/images/bildschirmfoto-2024-01-31-um-18.15.09-3400x1986.webp\" alt=\"Mobirise Website Builder\">\n                        <div class=\"icon-wrap\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-play mobi-mbri\"></span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n    <div>\n        <div class=\"modalWindow\" style=\"display: none;\">\n            <div class=\"modalWindow-container\">\n                <div class=\"modalWindow-video-container\">\n                    <div class=\"modalWindow-video\">\n                        <iframe width=\"100%\" height=\"100%\" data-src=\"{{modalVideo}}\" frameborder=\"0\" allowfullscreen=\"1\"></iframe>\n                    </div>\n                    <a class=\"close\" role=\"button\" data-dismiss=\"modal\" data-bs-dismiss=\"modal\">\n                        <span aria-hidden=\"true\" class=\"mbr-iconfont mobi-mbri-close mobi-mbri closeModal\"></span>\n                        <span class=\"sr-only visually-hidden visually-hidden\">Close</span>\n                    </a>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_cid": "v8MLPlJGHx",
          "_anchor": "avideo1-91",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "map02",
          "_sourceTheme": "curem4",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"map2\" group=\"Maps\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" name=\"fullWidth\" title=\"Full Width\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"1\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Phone\" name=\"showPhone\" checked>\n        <input type=\"checkbox\" title=\"Button\" name=\"showButton\" checked>\n                <input type=\"checkbox\" title=\"Social\" name=\"showSocial\">\n        <input type=\"range\" name=\"socialCount\" title=\"Social Count\" min=\"1\" max=\"4\" step=\"1\" value=\"1\" condition=\"showSocial\">\n        <input type=\"color\" title=\"Social Color\" name=\"iconColor\" value=\"#5b6c8f\" condition=\"showSocial\" selected>\n        \n        <header>Map</header>\n        <input type=\"map\" title=\"Map\" name=\"googleMap\" place-id=\"<iframe src=&quot;https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d819.2982519744854!2d32.42894805456382!3d34.77591612641355!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x14e7068a24c92d05%3A0xd074e91bd54784e3!2sImittou%2C%20Paphos%208011%2C%20Cyprus!5e0!3m2!1sen!2sde!4v1701728357514!5m2!1sen!2sde&quot; width=&quot;600&quot; height=&quot;450&quot; style=&quot;border:0;&quot; allowfullscreen=&quot;&quot; loading=&quot;lazy&quot; referrerpolicy=&quot;no-referrer-when-downgrade&quot;></iframe>\" value=\"<iframe src=&quot;https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d819.2982519744854!2d32.42894805456382!3d34.77591612641355!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x14e7068a24c92d05%3A0xd074e91bd54784e3!2sImittou%2C%20Paphos%208011%2C%20Cyprus!5e0!3m2!1sen!2sde!4v1701728357514!5m2!1sen!2sde&quot; width=&quot;600&quot; height=&quot;450&quot; style=&quot;border:0;&quot; allowfullscreen=&quot;&quot; loading=&quot;lazy&quot; referrerpolicy=&quot;no-referrer-when-downgrade&quot;></iframe>\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/curem4/components/_images/background1.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/curem4/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n    <div mbr-class=\"{'container': !fullWidth}\">\n        <div class=\"row align-left\">\n        <div class=\"col-lg-5\">\n                <h5 mbr-text class=\"mbr-section-subtitle mbr-fonts-style mb-3\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"><b>Σας κινήσαμε το ενδιαφέρον;</b></h5>\n            <p class=\"mbr-text mbr-fonts-style mb-5\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-text\" mbr-if=\"showSubtitle\">Κάντε κλικ στο chat για άμεση επικοινωνία!</p>\n            <hr mbr-if=\"showSubtitle\">\n                <h6 mbr-text class=\"phone mbr-fonts-style mt-4 mb-4\" data-app-selector=\".phone\" mbr-theme-style=\"display-2\" mbr-if=\"showPhone\"><b>+30 697 671 3377</b></h6>\n                <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list, .mbr-section-btn\" data-multiline mbr-article>\n                    <li class=\"mbr-text item-wrap\">Δευ – Παρ: 9:00-18:00</li>\n                </ul>\n                 <div mbr-buttons mbr-theme-style=\"display-4\" mbr-if=\"showButton\" class=\"mbr-section-btn mt-3 mb-4\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-md btn-white\" href=\"mailto:info@ela-tourism-technologies.com\" data-app-placeholder=\"Type Text\">info@all-in-one-digital-hotel.com</a></div>\n            <hr mbr-if=\"showSocial\">\n            <div class=\"social-row mt-4 mb-3 display-7\" mbr-if=\"showSocial\">\n                    <div class=\"soc-item\">\n                        <a href=\"https://twitter.com/mobirise\" target=\"_blank\">\n                            <span mbr-icon class=\"mbr-iconfont socicon socicon-facebook\"></span>\n                        </a>\n                    </div>\n                    <div class=\"soc-item\" mbr-if=\"socialCount>1\">\n                        <a href=\"https://twitter.com/mobirise\" target=\"_blank\">\n                            <span mbr-icon class=\"mbr-iconfont socicon socicon-twitter\"></span>\n                        </a>\n                    </div>\n                    <div class=\"soc-item\" mbr-if=\"socialCount>2\">\n                        <a href=\"https://twitter.com/mobirise\" target=\"_blank\">\n                            <span mbr-icon class=\"mbr-iconfont socicon socicon-instagram\"></span>\n                        </a>\n                    </div>\n                    <div class=\"soc-item\" mbr-if=\"socialCount>3\">\n                        <a href=\"https://twitter.com/mobirise\" target=\"_blank\">\n                            <span mbr-icon class=\"mbr-iconfont socicon-amazon socicon\"></span>\n                        </a>\n                    </div>\n                </div>\n        </div>\n        <div class=\"col-lg-7\">\n        <div class=\"google-map\" mbr-map=\"googleMap\">\n        </div></div>\n    </div></div>\n</section>",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".btn": {
              "border": "1px solid #efefef"
            },
            ".row": {
              "align-items": "center"
            },
            ".mbr-iconfont": {
              "color": "@iconColor"
            },
            "@media (max-width: 767px)": {
              ".row": {
                "text-align": "center"
              },
              ".social-row": {
                "justify-content": "center"
              }
            },
            ".list": {
              "list-style": "none",
              "padding-left": "0",
              "@media (max-width: 991px)": {
                "margin-bottom": "2rem"
              },
              "@media (min-width: 992px)": {
                "margin-bottom": "0rem"
              },
              "color": "#5b6c8f"
            },
            ".google-map": {
              "height": "34rem",
              "position": "relative",
              "iframe": {
                "height": "100%",
                "width": "100%"
              },
              "[data-state-details]": {
                "color": "#6b6763",
                "height": "1.5em",
                "margin-top": "-0.75em",
                "padding-left": "1.25rem",
                "padding-right": "1.25rem",
                "position": "absolute",
                "text-align": "center",
                "top": "50%",
                "width": "100%"
              },
              "&[data-state]": {
                "background": "#e9e5dc"
              },
              "&[data-state=\"loading\"]": {
                "[data-state-details]": {
                  "display": "none"
                }
              }
            },
            ".social-row": {
              "display": "flex",
              "flex-wrap": "wrap"
            },
            ".soc-item": {
              "display": "flex",
              "align-items": "center",
              "justify-content": "center",
              "margin-right": "0.5rem",
              "margin-bottom": "1rem",
              "padding": "0rem",
              "height": "2rem",
              "width": "2rem"
            },
            ".mbr-section-subtitle": {
              "color": "#fc7942"
            },
            ".mbr-text": {
              "color": "#5b6c8f"
            },
            ".phone": {
              "color": "#103178"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
