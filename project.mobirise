              },
              ".btn": {
                "&:not(:focus):not(:hover):not(.active) when (@showStyles)": {
                  "color": "@tabsColor !important"
                },
                "transition": "all 0.5s",
                "border": "none !important",
                "padding-top": "0.6rem",
                "padding-bottom": "0.6rem",
                "box-shadow": "0 0 15px 0 rgba(0, 0, 0, 0.1)",
                "&:after": {
                  "display": "none"
                },
                "& when (@showStyles)": {
                  "background": "transparent !important",
                  "&.active, &:hover": {
                    "background": "@tabsBg !important",
                    "color": "contrast(@tabsBg) !important"
                  }
                }
              },
              "@media (min-width: 768px)": {
                ".btn": {
                  "margin": "0px !important"
                },
                ".nav-item:first-child .btn": {
                  "border-top-right-radius": "0 !important",
                  "border-bottom-right-radius": "0 !important"
                },
                ".nav-item:last-child .btn": {
                  "border-top-left-radius": "0 !important",
                  "border-bottom-left-radius": "0 !important"
                }
              }
            },
            ".line": {
              "width": "35px",
              "height": "3px",
              "display": "inline-block",
              "background": "@lineColor",
              "transition": "background 0.3s",
              "margin-bottom": "1.5rem"
            },
            ".line2": {
              "background": "@lineColor2"
            },
            ".plan": {
              "word-break": "break-word",
              "box-shadow": "0 0 15px 0 rgba(0, 0, 0, 0.1)",
              "position": "relative",
              "padding-right": "0",
              "padding-left": "0",
              ".list-group-item": {
                "position": "relative",
                "-webkit-justify-content": "center",
                "justify-content": "center",
                "border": "0",
                "&::after": {
                  "position": "absolute",
                  "bottom": "0",
                  "left": "20%",
                  "width": "60%",
                  "height": "2px",
                  "content": "''",
                  "background-color": "#eaeaea"
                },
                "&:last-child::after": {
                  "display": "none"
                }
              }
            },
            ".plan-header, .plan-body": {
              "background-color": "#fff"
            },
            ".price-figure": {
              "font-weight": "700"
            },
            ".price-value": {
              "font-weight": "700",
              "vertical-align": "top"
            },
            "@media (max-width: 550px)": {
              ".price-figure": {
                "font-size": "4.25rem"
              }
            },
            ".color1": {
              "color": "#255085"
            },
            ".color2": {
              "color": "#ed4266"
            },
            "LI": {
              "color": "#767676"
            },
            ".price-term": {
              "color": "#767676"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"tabs2 politicsm4_tabs02 tabs\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" group=\"Pricing Tables\" mbr-class=\"{'mbr-parallax-background':bg.parallax}\" plugins=\"mbr-tabs\">\n\n\t<mbr-parameters>\n\t\t<header>Size</header>\n\t\t<input inline max=\"8\" min=\"0\" name=\"paddingTop\" step=\"1\" title=\"Top\" type=\"range\" value=\"4\">\n\t\t<input inline max=\"8\" min=\"0\" name=\"paddingBottom\" step=\"1\" title=\"Bottom\" type=\"range\" value=\"4\">\n\t\t<select name=\"itemsCount\" title=\"Items Count\">\n\t\t\t<option value=\"1\">1</option>\n\t\t\t<option value=\"2\">2</option>\n\t\t\t<option value=\"3\">3</option>\n\t\t\t<option selected value=\"4\">4</option>\n\t\t</select>\n\t\t<header>Show / Hide</header>\n\t\t<input name=\"showStyles\" title=\"Styles Tabs\" type=\"checkbox\" checked>\n\t\t<input checked name=\"showButtons\" title=\"Buttons\" type=\"checkbox\">\n\t\t<header>Colors</header>\n\t\t<input condition=\"showStyles\" name=\"tabsColor\" title=\"Tabs\" type=\"color\" value=\"#ffffff\">\n\t\t<input condition=\"showStyles\" name=\"tabsBg\" title=\"Tab Bg Active\" type=\"color\" value=\"#ef5311\">\n\t\t<input name=\"lineColor\" selected title=\"Line\" type=\"color\" value=\"#ef5311\">\n\t\t<input name=\"lineColor2\" selected title=\"Line 2\" type=\"color\" value=\"#255085\">\n\t\t<header>Background</header>\n\t\t<fieldset name=\"bg\" parallax type=\"background\">\n\t\t\t<input title=\"Image\" type=\"image\" value=\"@PROJECT_PATH@/assets/images/mbr-1920x1282.webp\" selected>\n\t\t\t<input title=\"Color\" type=\"color\" value=\"#ffffff\">\n\t\t\t<input title=\"Video\" type=\"video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n\t\t</fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n\t\t<input condition=\"bg.type !== 'color'\" name=\"overlay\" title=\"Overlay\" type=\"checkbox\" checked>\n\t\t<input condition=\"overlay && bg.type !== 'color'\" name=\"overlayColor\" title=\"Overlay Color\" type=\"color\" value=\"#bbbbbb\">\n\t\t<input condition=\"overlay && bg.type !== 'color'\" inline max=\"1\" min=\"0\" name=\"overlayOpacity\" step=\"0.1\" title=\"Opacity\" type=\"range\" value=\"0.8\">\n\t</mbr-parameters>\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\n\n\t<div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\"></div>\n\n\t<div class=\"container d-flex flex-column\">\n\t\t<ul class=\"nav nav-tabs mb-4 d-flex justify-content-center mx-auto\" role=\"tablist\">\n\t\t\t<li class=\"nav-item first mbr-section-btn\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrBtnColor,-mbrLink,-mbrBtnRemove\" mbr-buttons mbr-theme-style=\"display-7\" role=\"presentation\"><a aria-controls=\"politics2-tab1-content\" aria-selected=\"true\" class=\"btn mbr-fonts-style btn-sm show btn-secondary-outline active\" data-app-placeholder=\"Type Text\" data-toggle=\"tab\" href=\"#tabs02-5f_tab0\" role=\"tab\" data-bs-toggle=\"tab\">ΕΤΗΣΙΑ FLEX MULTIPLE ID VR</a></li>\n\t\t\t<li class=\"nav-item mbr-section-btn\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrBtnColor,-mbrLink,-mbrBtnRemove\" mbr-buttons mbr-theme-style=\"display-7\" role=\"presentation\"><a aria-controls=\"politics2-tab2-content\" aria-selected=\"true\" class=\"btn mbr-fonts-style btn-sm btn-white active\" data-app-placeholder=\"Type Text\" data-toggle=\"tab\" href=\"#tabs02-5f_tab1\" role=\"tab\" data-bs-toggle=\"tab\">MΗΝΙΑΙΑ FLEX MULTIPLE&nbsp; ID VR</a></li>\n\t\t</ul>\n\t\t<div class=\"tab-content\">\n\t\t\t<div aria-labelledby=\"politics2-tab1\" class=\"tab-pane active\" id=\"politics2-tab1-content\" role=\"tabpanel\">\n\t\t\t\t<div class=\"row\">\n\n\t\t\t\t\t<div class=\"col-12 col-md-6 my-3 justify-content-center\" mbr-class=\"{'col-lg-4': itemsCount == 3, 'col-lg-6': itemsCount == 2, 'col-lg-3': itemsCount == 4}\" mbr-if=\"itemsCount > 0\">\n\t\t\t\t\t\t<div class=\"plan\">\n\t\t\t\t\t\t<div class=\"plan-header text-center\">\n\t\t\t\t\t\t\t<h3 class=\"plan-title mbr-semibold pb-3 mbr-fonts-style\" data-app-selector=\".plan-title\" mbr-theme-style=\"display-4\">SETUP FREE</h3>\n\t\t\t\t\t\t\t<div class=\"plan-price\">\n\t\t\t\t\t\t\t\t<h3 class=\"price-figure color1 pb-1 mbr-fonts-style\" data-app-selector=\".color1\" mbr-text mbr-theme-style=\"display-1\">€0</h3>\n\t\t\t\t\t\t\t\t<h4 class=\"price-term pb-3 mbr-fonts-style\" data-app-selector=\".price-term\" mbr-text mbr-theme-style=\"display-7\">χωρίς χρέωση</h4>\n\t\t\t\t\t\t\t\t<div class=\"line-wrap\">\n\t\t\t\t\t\t\t\t\t<div class=\"line\"></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"plan-body\">\n\t\t\t\t\t\t\t<div class=\"plan-list align-center\">\n\t\t\t\t\t\t\t\t<ul class=\"list-group list-group-flush mbr-fonts-style\" mbr-text mbr-theme-style=\"display-7\">\n\t\t\t\t\t\t\t\t\t<li class=\"list-group-item\">Λογ/σμός All in One PMS</li>\n\t\t\t\t\t\t\t\t\t<li class=\"list-group-item\">Σετάρισμα στοιχείων PMS</li>\n\t\t\t\t\t\t\t\t\t<li class=\"list-group-item\">Δημιουργία τιμοκαταλόγων</li>\n\t\t\t\t\t\t\t\t\t<li class=\"list-group-item\">Μηχανή κρατήσεων</li><li class=\"list-group-item\">Μέχρι 3 χρήστες</li><li class=\"list-group-item\">LIVE Chat εξυπηρέτηση</li><li class=\"list-group-item\"><br></li>\n\t\t\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"mbr-section-btn text-center pt-4 \" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-if=\"showButtons\" mbr-theme-style=\"display-4\"><a class=\"btn btn-sm btn-primary\" data-app-placeholder=\"Type Text\" href=\"mbrext://smart-cart?cmdsm=_cart&amount=0.00&item_name=SETUP%20FREE%20All%20in%20One%20HOTEL&currency_code=EUR&dataShop=smartCart\">ONLINE DEAL</a></div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\n\t\t\t\t\t<div class=\"col-12 col-md-6 my-3 justify-content-center\" mbr-class=\"{'col-lg-4': itemsCount == 3, 'col-lg-6': itemsCount == 2, 'col-lg-3': itemsCount == 4}\" mbr-if=\"itemsCount > 1\">\n\t\t\t\t\t\t<div class=\"plan\">\n\t\t\t\t\t\t<div class=\"plan-header text-center\">\n\t\t\t\t\t\t\t<h3 class=\"plan-title mbr-semibold pb-3 mbr-fonts-style\" data-app-selector=\".plan-title\" mbr-theme-style=\"display-4\">All in one MULTIPLE FLEX*</h3>\n\t\t\t\t\t\t\t<div class=\"plan-price\">\n\t\t\t\t\t\t\t\t<h3 class=\"price-figure color2 pb-1 mbr-fonts-style\" data-app-selector=\".color2\" mbr-text mbr-theme-style=\"display-1\">€90</h3>\n\t\t\t\t\t\t\t\t<h4 class=\"price-term pb-3 mbr-fonts-style\" data-app-selector=\".price-term\" mbr-text mbr-theme-style=\"display-7\">*ετήσια ανά ID=unit (μέχρι 50 ανά λογ/σμό) + €4/check-in</h4>\n\t\t\t\t\t\t\t\t<div class=\"line-wrap\">\n\t\t\t\t\t\t\t\t\t<div class=\"line line2 \"></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"plan-body\">\n\t\t\t\t\t\t\t<div class=\"plan-list align-center\">\n\t\t\t\t\t\t\t\t<ul class=\"list-group list-group-flush mbr-fonts-style\" mbr-text mbr-theme-style=\"display-7\">\n\t\t\t\t\t\t\t\t\t<li class=\"list-group-item\">Σετάρισμα All in One Channel Manager</li>\n\t\t\t\t\t\t\t\t\t<li class=\"list-group-item\">Σύνδεση με 4 πόρταλ επιλογής σας (βλ. λίστα)</li>\n\t\t\t\t\t\t\t\t\t<li class=\"list-group-item\">Σετάρισμα μηχανής κρατήσεων με BOOK NOW Button με + €4/check-in</li>\n\t\t\t\t\t\t\t\t\t<li class=\"list-group-item\">ΔΩΡΕΑΝ σύνδεση myDATA</li><li class=\"list-group-item\">ΔΩΡΕΑΝ ενεργοποίηση PCI για κάρτες</li>\n\t\t\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"mbr-section-btn text-center pt-4 \" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-if=\"showButtons\" mbr-theme-style=\"display-4\"><a class=\"btn btn-sm btn-secondary\" data-app-placeholder=\"Type Text\" href=\"mbrext://smart-cart?cmdsm=_cart&amount=81&item_name=All%20in%20One%20FLEX%20MULTIPLE%20ID%20(E%CE%A4%CE%97%CE%A3%CE%99%CE%91)%3A%20%CE%95%CE%B9%CF%83%CE%AC%CE%B3%CE%B5%CF%84%CE%B5%20%CF%80%CE%AC%CE%BD%CF%89%20%CE%B1%CF%80%CF%8C%203%20ID&currency_code=EUR&dataShop=smartCart\">ONLINE -10%</a></div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\n\t\t\t\t\t<div class=\"col-12 col-md-6 my-3 justify-content-center\" mbr-class=\"{'col-lg-4': itemsCount == 3, 'col-lg-6': itemsCount == 2, 'col-lg-3': itemsCount == 4}\" mbr-if=\"itemsCount > 1\">\n\t\t\t\t\t\t<div class=\"plan\">\n\t\t\t\t\t\t<div class=\"plan-header text-center\">\n\t\t\t\t\t\t\t<h3 class=\"plan-title mbr-semibold pb-3 mbr-fonts-style\" data-app-selector=\".plan-title\" mbr-theme-style=\"display-4\">ONLINE PORTALS*</h3>\n\t\t\t\t\t\t\t<div class=\"plan-price\">\n\t\t\t\t\t\t\t\t<h3 class=\"price-figure color1 pb-1 mbr-fonts-style\" data-app-selector=\".color1\" mbr-text mbr-theme-style=\"display-1\">€100</h3>\n\t\t\t\t\t\t\t\t<h4 class=\"price-term pb-3 mbr-fonts-style\" data-app-selector=\".price-term\" mbr-text mbr-theme-style=\"display-7\">*ανά πόρταλ / ετησίως για επιπλέον συνδέσεις πέραν των 4 πόρταλ</h4>\n\t\t\t\t\t\t\t\t<div class=\"line-wrap\">\n\t\t\t\t\t\t\t\t\t<div class=\"line\"></div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"plan-body\">\n\t\t\t\t\t\t\t<div class=\"plan-list align-center\">\n\t\t\t\t\t\t\t\t<ul class=\"list-group list-group-flush mbr-fonts-style\" mbr-text mbr-theme-style=\"display-7\">\n\t\t\t\t\t\t\t\t\t<li class=\"list-group-item\">1. ΔΩΡΕΑΝ Σύνδεση με 4 πόρταλ από την παρακάτω λίστα:</li><li class=\"list-group-item\">Booking, Expedia, AirBnB, agoda, CTrip, HipCamp, Hopper, Hostelworld, hotelbeds, HRS, HyperGuest, MakeMyTrip, Mr &amp; Mrs Smith, Wink, HomeAway / VRBO</li><li class=\"list-group-item\">2. Επιπλέον συνδέσεις με extra χρέωση:</li><li class=\"list-group-item\">Avis, Budget, Europcar, Hertz</li><li class=\"list-group-item\">GDS 400.000+ travel agents (amadeus, sabre, travelport, Pegasus)</li><li class=\"list-group-item\">Trivago, Metasearch, Google Hotel Search, Google VR</li><li class=\"list-group-item\">atrapalo, bedandbreakfast, bestfewo, check24, corporate rates club, ebay, eDreams ODIGEOm goibibo, Greenstorm, Hostelsclub, HotelSpecials, interhome, kurz-mal-weg, ostrovok, Schmetterling, TOMAS, TravelRepublic</li>\n\t\t\t\t\t\t\t\t\t<li class=\"list-group-item\">Προϋπόθεση: Έχετε ήδη συμβόλαιο με το OTA, και τα στοιχεία είναι σεταρισμένα σωστά σε αυτό</li>\n\t\t\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"mbr-section-btn text-center pt-4 \" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-if=\"showButtons\" mbr-theme-style=\"display-4\"><a class=\"btn btn-sm btn-secondary\" data-app-placeholder=\"Type Text\" href=\"mbrext://smart-cart?cmdsm=_cart&amount=90.00&item_name=All%20in%20One%20OTA%3A%20%CE%95%CF%80%CE%B9%CE%BB%CE%AD%CE%BE%CF%84%CE%B5%20%CF%84%CE%BF%CE%BD%20%CE%B1%CF%81%CE%B9%CE%B8%CE%BC%CF%8C%20%CE%B5%CF%80%CE%B9%CF%80%CE%BB%CE%AD%CE%BF%CE%BD%20%CF%80%CF%8C%CF%81%CF%84%CE%B1%CE%BB&currency_code=EUR&dataShop=smartCart\">ONLINE -10%</a></div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\n\t\t\t\t\t<div class=\"col-12 col-md-6 my-3 justify-content-center\" mbr-class=\"{'col-lg-4': itemsCount == 3, 'col-lg-6': itemsCount == 2, 'col-lg-3': itemsCount == 4}\" mbr-if=\"itemsCount > 3\">\n\t\t\t\t\t\t<div class=\"plan\">\n\t\t\t\t\t\t<div class=\"plan-header text-center\">\n\t\t\t\t\t\t\t<h3 class=\"plan-title mbr-semibold pb-3 mbr-fonts-style\" data-app-selector=\".plan-title\" mbr-theme-style=\"display-4\">IMPORT DATA</h3>\n\t\t\t\t\t\t\t<div class=\"plan-price\">\n\t\t\t\t\t\t\t\t<h3 class=\"price-figure color2 pb-1 mbr-fonts-style\" data-app-selector=\".color2\" mbr-text mbr-theme-style=\"display-1\">€79</h3>\n\t\t\t\t\t\t\t\t<h4 class=\"price-term pb-3 mbr-fonts-style\" data-app-selector=\".price-term\" mb