== 'video'\">\n\n\t\t<input checked condition=\"bg.type !== 'color'\" name=\"overlay\" title=\"Overlay\" type=\"checkbox\">\n\t\t<input condition=\"overlay && bg.type !== 'color'\" name=\"overlayColor\" title=\"Overlay Color\" type=\"color\" value=\"#bbbbbb\">\n\t\t<input condition=\"overlay && bg.type !== 'color'\" inline max=\"1\" min=\"0\" name=\"overlayOpacity\" step=\"0.1\" title=\"Opacity\" type=\"range\" value=\"0.8\">\n\t</mbr-parameters>\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\n\n\t<div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\"></div>\n\n\t<div class=\"container d-flex flex-column\">\n\t\t<ul class=\"nav nav-tabs mb-4 d-flex justify-content-center mx-auto\" role=\"tablist\">\n\t\t\t<li class=\"nav-item first mbr-section-btn\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrBtnColor,-mbrLink,-mbrBtnRemove\" mbr-buttons mbr-theme-style=\"display-7\" role=\"presentation\"><a aria-controls=\"politics2-tab1-content\" aria-selected=\"true\" class=\"btn mbr-fonts-style btn-sm show btn-secondary-outline active\" data-app-placeholder=\"Type Text\" data-toggle=\"tab\" href=\"#tabs02-52_tab0\" role=\"tab\" data-bs-toggle=\"tab\">ΕΤΗΣΙΑ FLAT HOTEL &lt;7</a></li>\n\t\t\t<li class=\"nav-item mbr-section-btn\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrBtnColor,-mbrLink,-mbrBtnRemove\" mbr-buttons mbr-theme-style=\"display-7\" role=\"presentation\"><a aria-controls=\"politics2-tab2-content\" aria-selected=\"true\" class=\"btn mbr-fonts-style btn-sm btn-secondary-outline active\" data-app-placeholder=\"Type Text\" data-toggle=\"tab\" href=\"#tabs02-52_tab1\" role=\"tab\" data-bs-toggle=\"tab\">MΗΝΙΑΙΑ FLAT HOTEL &lt;7</a></li>\n\t\t</ul>\n\t\t<div class=\"tab-content\">\n\t\t\t<div aria-labelledby=\"politics2-tab1\" class=\"tab-pane active\" id=\"politics2-tab1-content\" role=\"tabpanel\">\n\t\t\t\t<div class=\"row\">\n\n\t\t\t\t\t<div cl