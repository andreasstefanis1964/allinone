              },
              "@media (max-width: 767px)": {
                "margin-top": "15px"
              },
              "a.text-primary": {
                "&:hover": {
                  "color": "#131313 !important"
                }
              }
            },
            ".card-title, .iconfont-wrapper": {
              "text-align": "center"
            }
