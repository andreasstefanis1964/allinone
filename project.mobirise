        {
          "_name": "tabs02",
          "_sourceTheme": "politicsm4",
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "& when (@bg-type = 'color')": {
              "background": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".list-group-item": {
              "padding": "0.5rem 3.25rem"
            },
            "h4": {
              "margin": "0"
            },
            ".plan-body .mbr-section-btn .btn-sm": {
              "padding": "0.6rem 4.4rem"
            },
            ".plan-body": {
              "padding-bottom": "2rem"
            },
            ".plan-header": {
              "padding-top": "2rem",
              "padding-left": "1rem",
              "padding-right": "1rem"
            },
            ".nav-tabs": {
              "border": "none !important",
              ".nav-item": {
                "margin": "0"
              },
              ".btn": {
                "&:not(:focus):not(:hover):not(.active) when (@showStyles)": {
                  "color": "@tabsColor !important"
                },
                "transition": "all 0.5s",
                "border": "none !important",
                "padding-top": "0.6rem",
                "padding-bottom": "0.6rem",
                "box-shadow": "0 0 15px 0 rgba(0, 0, 0, 0.1)",
                "&:after": {
                  "display": "none"
                },
                "& when (@showStyles)": {
                  "background": "transparent !important",
                  "&.active, &:hover": {
                    "background": "@tabsBg !important",
                    "color": "contrast(@tabsBg) !important"
                  }
                }
              },
              "@media (min-width: 768px)": {
                ".btn": {
                  "margin": "0px !important"
                },
                ".nav-item:first-child .btn": {
                  "border-top-right-radius": "0 !important",
                  "border-bottom-right-radius": "0 !important"
                },
                ".nav-item:last-child .btn": {
                  "border-top-left-radius": "0 !important",
                  "border-bottom-left-radius": "0 !important"
                }
              }
            },
            ".line": {
              "width": "35px",
              "height": "3px",
              "display": "inline-block",
              "background": "@lineColor",
              "transition": "background 0.3s",
              "margin-bottom": "1.5rem"
            },
            ".line2": {
              "background": "@lineColor2"
            },
            ".plan": {
              "word-break": "break-word",
              "box-shadow": "0 0 15px 0 rgba(0, 0, 0, 0.1)",
              "position": "relative",
              "padding-right": "0",
              "padding-left": "0",
              ".list-group-item": {
                "position": "relative",
                "-webkit-justify-content": "center",
                "justify-content": "center",
                "border": "0",
                "&::after": {
                  "position": "absolute",
                  "bottom": "0",
                  "left": "20%",
                  "width": "60%",
                  "height": "2px",
                  "content": "''",
                  "background-color": "#eaeaea"
                },
                "&:last-child::after": {
                  "display": "none"
                }
              }
            },
            ".plan-header, .plan-body": {
              "background-color": "#fff"
            },
            ".price-figure": {
              "font-weight": "700"
            },
            ".price-value": {
              "font-weight": "700",
              "vertical-align": "top"
            },
            "@media (max-width: 550px)": {
              ".price-figure": {
                "font-size": "4.25rem"
              }
            },
            ".color1": {
              "color": "#255085"
            },
            ".color2": {
              "color": "#ed4266"
            },
            "LI": {
              "color": "#767676"
            },
            ".price-term": {
              "color": "#767676"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
