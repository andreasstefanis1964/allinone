        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)",
              "& when (@overlay)": {
                ".mbr-overlay": {
                  "background": "@overlayColor",
                  "opacity": "@overlayOpacity"
                }
              }
            },
            ".row": {
              "justify-content": "center"
            },
            "img, .item-img": {
              "width": "100%",
              "height": "100%",
              "object-fit": "cover"
            },
            ".item:focus, span:focus": {
              "outline": "none"
            },
            ".item": {
              "cursor": "pointer",
              "margin-bottom": "2rem"
            },
            ".item-wrapper": {
              "position": "relative",
              "background": "transparent",
              "height": "100%",
              "display": "flex",
              "flex-flow": "column nowrap",
              "justify-content": "flex-end",
              "min-height": "370px",
              "padding": "35px",
              "@media (min-width: 992px)": {
                "min-height": "463px"
              },
              ".btn": {
                "padding": "10px 12px",
                "span": {
                  "color": "#222222",
                  "margin": "0 8px"
                }
              },
              ".btn-primary": {
                "&:hover": {
                  "background-color": "#222222 !important",
                  "border-color": "#222222 !important",
                  "span": {
                    "color": "@primaryColor !important"
                  }
                }
              },
              "overflow": "hidden",
              "@media (min-width: 768px)": {
                "&:hover": {
                  "& img": {
                    "transform": "scale(1)"
                  }
                }
              }
            },
            ".item-img": {
              "position": "absolute",
              "top": "0",
              "left": "0",
              "width": "100%",
              "height": "100%",
              "overflow": "hidden",
              "& img": {
                "width": "100%",
                "transform": "scale(1.2)",
                "transform-style": "preserve-3d",
                "transition": "2s"
              }
            },
            ".img-overlay": {
              "position": "absolute",
              "top": "0",
              "width": "100%",
              "height": "100%",
              "background-color": "#000000",
              "opacity": "0.2",
              "pointer-events": "none"
            },
            ".item-content": {
              "position": "relative",
              "z-index": "3",
              "padding": "0"
            },
            ".mbr-section-title": {
              "color": "#222222",
              "width": "100%"
            },
            ".mbr-text": {
              "color": "#ffffff"
            },
            ".item-title": {
              "color": "#ffffff",
              "text-align": "left"
            },
            ".item-subtitle": {
              "color": "#ffffff",
              "text-align": "center"
            },
            ".icon-wrapper": {
              "margin-bottom": "1rem",
              ".mbr-iconfont": {
                "font-size": "33px",
                "color": "@iconColor"
              }
            },
            ".mbr-section-head": {
              "display": "flex",
              "flex-direction": "column",
              "justify-content": "flex-end",
              "margin-bottom": "4rem",
              "@media (min-width: 992px)": {
                "padding-left": "30px",
                "padding-right": "6rem",
                "margin-bottom": "2rem"
              }
            }
          },
          "_name": "agallery1",
          "_sourceTheme": "solarm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"gallery1\" group=\"Sliders & Galleries\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"1\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" name=\"showTitle\" title=\"Title\" checked>\n        <input type=\"checkbox\" name=\"showSubtitle\" title=\"Subtitle\" checked>\n        <header>Cards</header>\n        <input type=\"checkbox\" name=\"showCardIcon\" title=\"Icon\">\n        <input type=\"color\" title=\"Icon Color\" name=\"iconColor\" value=\"#ffffff\" condition=\"showCardIcon\">\n        <input type=\"checkbox\" name=\"showCardTitle\" title=\"Title\" checked>\n        <input type=\"checkbox\" name=\"showText\" title=\"Text\">\n        <input type=\"checkbox\" name=\"showButtons\" title=\"Buttons\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" required>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/solarm5/components/_images/background3.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ff9466\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type == 'image'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type == 'image'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"mbr-section-head col-12 col-lg-3\" mbr-if=\"showTitle || showSubtitle\">\n                <h4 class=\"mbr-section-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\"><b>Μερικά από τα έργα μας...</b></h4>\n                <h5 class=\"mbr-section-subtitle mbr-fonts-style mb-0 mt-2\" mbr-theme-style=\"display-4\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\">για πελάτες μας στην Ελλάδα</h5>\n            </div>\n            <div class=\"item features-image col-12 col-md-4 col-lg-3\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-img\">\n                        <a href=\"https://villaloom-mykonos.com\" target=\"_blank\"><img src=\"@PROJECT_PATH@/assets/images/bildschirmfoto-2024-01-31-um-21.45.54-994x1802.webp\" alt></a>\n                        <div class=\"img-overlay\"></div>\n                    </div>\n                    <div class=\"item-content\" mbr-if=\"showCardTitle || showCardIcon || showText || showButtons\">\n                        <div class=\"icon-wrapper\" mbr-if=\"showCardIcon\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-layers mobi-mbri\"></span>\n                        </div>\n                        <h5 class=\"item-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\"></h5>\n                        <p class=\"mbr-text mbr-fonts-style\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text, .mbr-section-btn\">RESIDENTIAL</p>\n                        <div class=\"mbr-section-btn item-footer mt-2\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-7\"><a href=\"https://villaloom-mykonos.com\" class=\"btn btn-primary item-btn\" target=\"_blank\" data-app-placeholder=\"Type Text\"><span class=\"mobi-mbri mobi-mbri-right mbr-iconfont mbr-iconfont-btn\"></span></a></div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"item features-image col-12 col-md-4 col-lg-3\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-img\">\n                        <a href=\"https://galini-apartments-polichrono.com/\" target=\"_blank\"><img src=\"@PROJECT_PATH@/assets/images/bildschirmfoto-2025-03-31-um-08.29.54.webp\" alt></a>\n                        <div class=\"img-overlay\"></div>\n                    </div>\n                    <div class=\"item-content\" mbr-if=\"showCardTitle || showCardIcon || showText || showButtons\">\n                        <div class=\"icon-wrapper\" mbr-if=\"showCardIcon\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-delivery mobi-mbri\"></span>\n                        </div>\n                        <h5 class=\"item-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\"></h5>\n                        <p class=\"mbr-text mbr-fonts-style\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text, .mbr-section-btn\">RESIDENTIAL</p>\n                        <div class=\"mbr-section-btn item-footer mt-2\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-7\"><a href=\"https://filoxenia-monemvasia.gr\" class=\"btn btn-primary item-btn\" target=\"_blank\" data-app-placeholder=\"Type Text\"><span class=\"mobi-mbri mobi-mbri-right mbr-iconfont mbr-iconfont-btn\"></span></a></div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"item features-image col-12 col-md-4 col-lg-3\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-img\">\n                        <a href=\"https://www.ionianreserve.com/en\" target=\"_blank\"><img src=\"@PROJECT_PATH@/assets/images/bildschirmfoto-2025-03-30-um-20.13.17.webp\" alt></a>\n                        <div class=\"img-overlay\"></div>\n                    </div>\n                    <div class=\"item-content\" mbr-if=\"showCardTitle || showCardIcon || showText || showButtons\">\n                        <div class=\"icon-wrapper\" mbr-if=\"showCardIcon\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-briefcase mobi-mbri\"></span>\n                        </div>\n                        <h5 class=\"item-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\"></h5>\n                        <p class=\"mbr-text mbr-fonts-style\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text, .mbr-section-btn\">RESIDENTIAL</p>\n                        <div class=\"mbr-section-btn item-footer mt-2\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-7\"><a href=\"https://irluxuryvillas.com\" class=\"btn btn-primary item-btn\" target=\"_blank\" data-app-placeholder=\"Type Text\"><span class=\"mobi-mbri mobi-mbri-right mbr-iconfont mbr-iconfont-btn\"></span>\n                            </a></div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "u2YLz8C1eZ",
          "_anchor": "agallery1-5m",
