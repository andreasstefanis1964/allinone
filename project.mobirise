        {
          "_name": "pricing-tables2",
          "_sourceTheme": "petsm4",
          "_customHTML": "<section data-bs-version=\"5.1\" group=\"Pricing Tables\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background':bg.parallax}\" class=\"pricing-tables2 petsm4_pricing-tables2\">\n\n\t<mbr-parameters>\n\t\t\n\t\t<header>Size</header>\n\t\t<input inline type=\"range\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"4\">\n\t\t<input inline type=\"range\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"4\">\n\t\t<select title=\"Count\" name=\"itemsCount\">\n\t\t\t<option value=\"1\">1</option>\n\t\t\t<option value=\"2\">2</option>\n\t\t\t<option value=\"3\" selected>3</option>\n\t\t</select>\n\t\t<input type=\"range\" inline title=\"Items in 1\" name=\"items1Count\" min=\"0\" max=\"10\" step=\"1\" value=\"4\">\n\t\t<input type=\"range\" inline title=\"Items in 2\" name=\"items2Count\" min=\"0\" max=\"10\" step=\"1\" value=\"4\" condition=\"itemsCount > 1\">\n\t\t<input type=\"range\" inline title=\"Items in 3\" name=\"items3Count\" min=\"0\" max=\"10\" step=\"1\" value=\"4\" condition=\"itemsCount > 2\">\n\t\t<header>Show / Hide</header>\n\t\t<input type=\"checkbox\" title=\"Subtitle\" name=\"showTitle\" checked>\n\t\t<input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n\t\t<input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n\t\t<header>Color</header>\n\t\t<input type=\"color\" title=\"Icon\" name=\"icons\" value=\"#181818\" selected>\n\t\t<input type=\"color\" name=\"card1bg\" title=\"Cards\" value=\"#f2f2f4\" condition=\"itemsCount > 0\">\n\t\t<input type=\"color\" name=\"card2bg\" title=\"Primary Card\" value=\"#ed6436\" condition=\"itemsCount > 1\">\n\t\t<header>Background</header>\n\t\t<fieldset type=\"background\" name=\"bg\" parallax>\n\t\t\t<input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/mbr-1920x1282.webp\" selected>\n\t\t\t<input type=\"color\" title=\"Color\" value=\"#ffffff\">\n\t\t\t<input type=\"video\" title=\"Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n\t\t</fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/petsm4/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n\t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n\t\t<input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n\t\t<input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay && bg.type !== 'color'\">\n\t\t\n\t</mbr-parameters>\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\n\n\t<div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n\t</div>\n\n\t<div class=\"container d-flex flex-column\">\n\t\t<div class=\"tab-content\">\n\t\t\t<div id=\"tab1\" class=\"tab-pane in active\" role=\"tabpanel\">\n\t\t\t\t<div class=\"row\">\n\t\t\t\t\t<div class=\"col-md-12 content align-left col-lg-3\">\n\t\t\t\t\t\t<h2 class=\"mbr-section-title align-left mbr-bold pb-2 mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\">ΙΣΧΥΕΙ ΑΝΑ ΞΕΝΟΔΟΧΕΙΟ*</h2>\n\t\t\t\t\t\t<h1 class=\"mbr-section-title align-left mbr-bold pb-3 mbr-fonts-style\" mbr-theme-style=\"display-2\">Hot Deal</h1>\n\t\t\t\t\t\t<p class=\"mbr-text pb-3 align-left mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn, .content\">Χρειάζεστε μία γρήγορη και ευέλικτη λύση για το κατάλυμά σας;<br>Επιλέξτε μεταξύ 3 πακέτων:<br>(χωρίς επιβάρυνση ΦΠΑ εφόσον μας δηλώσετε το ΑΦΜ σας.<br>To κόστος εγκατάστασης στο All in One λογισμικό είναι εφάπαξ, πάγιο: €150,00)<br>*μέχρι 30 δωμάτια</p>\n\t\t\t\t\t\t<div mbr-buttons mbr-theme-style=\"display-4\" class=\"align-left mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-md btn-danger\" href=\"https://wa.me/49 173 95 41407\" data-app-placeholder=\"Type Text\">WhatsApp εδώ</a></div>\n\t\t\t\t\t</div>\n\n\t\t\t\t\t<div class=\"plan col-12 justify-content-center\" mbr-if=\"itemsCount > 0\" mbr-class=\"{\n                        'col-lg-3': itemsCount == 3,\n                        'col-lg-6': itemsCount == 2}\">\n\t\t\t\t\t\t<div class=\"plan-header card1\">\n\t\t\t\t\t\t\t<h3 class=\"plan-title mbr-black mbr-bold pb-1 mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".plan-title\">ALL IN ONE 3&nbsp;<br>(μέγιστη διάρκεια 3 μήνες)</h3>\n\t\t\t\t\t\t\t<h4 class=\"month mbr-black mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-2\" data-app-selector=\".month, .plan-header\">Μήνα</h4>\n\t\t\t\t\t\t\t<span class=\"mbr-iconfont pt-3 pb-2 icon mdi-image-filter-3\" mbr-icon></span>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"plan-body card1\">\n\t\t\t\t\t\t\t<div class=\"plan-list\" mbr-list mbr-list-grow=\"items1Count\" mbr-if=\"items1Count > 0\">\n\t\t\t\t\t\t\t\t<div class=\"plan-item d-flex justify-content-center\">\n\t\t\t\t\t\t\t\t\t<span class=\"mbr-iconfont mobi-mbri-success mobi-mbri\" mbr-icon style=\"color: rgb(239, 83, 17); fill: rgb(239, 83, 17);\"></span>\n\t\t\t\t\t\t\t\t\t<p class=\"mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".plan-item p, .plan-item .mbr-iconfont\">Λογισμικό PMS</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class=\"plan-item d-flex justify-content-center\">\n\t\t\t\t\t\t\t\t\t<span class=\"mbr-iconfont mobi-mbri-success mobi-mbri\" mbr-icon style=\"color: rgb(239, 83, 17); fill: rgb(239, 83, 17);\"></span>\n\t\t\t\t\t\t\t\t\t<p class=\"mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".plan-item p, .plan-item .mbr-iconfont\">Channel manager (μέχρι 4 πόρταλ)<br>\n\t\t\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class=\"plan-item d-flex justify-content-center\">\n\t\t\t\t\t\t\t\t\t<span class=\"mbr-iconfont mobi-mbri-success mobi-mbri\" mbr-icon style=\"color: rgb(239, 83, 17); fill: rgb(239, 83, 17);\"></span>\n\t\t\t\t\t\t\t\t\t<p class=\"mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".plan-item p, .plan-item .mbr-iconfont\">Booking engine (3%)<br></p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class=\"plan-item d-flex justify-content-center\">\n\t\t\t\t\t\t\t\t\t<span class=\"mbr-iconfont mobi-mbri-close mobi-mbri\" mbr-icon style=\"color: rgb(239, 83, 17); fill: rgb(239, 83, 17);\"></span>\n\t\t\t\t\t\t\t\t\t<p class=\"mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".plan-item p, .plan-item .mbr-iconfont\">ΔΩΡΕΑΝ σύνδεση με myDATA</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"plan-price\">\n\t\t\t\t\t\t\t\t<span mbr-text class=\"price-value mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".price-value, .plan-price\">€</span>\n\t\t\t\t\t\t\t\t<span mbr-text class=\"price-figure mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-2\" data-app-selector=\".price-figure, .plan-price\">70</span>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\n\t\t\t\t\t<div class=\"plan col-12 center-card justify-content-center\" mbr-if=\"itemsCount > 1\" mbr-class=\"{\n                        'col-lg-3': itemsCount == 3,\n                        'col-lg-6': itemsCount == 2}\">\n\t\t\t\t\t\t<div class=\"plan-header card2\">\n\t\t\t\t\t\t\t<h3 class=\"plan-title2 mbr-black mbr-bold pb-1 mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".plan-title2\">ALL IN ONE</h3>\n\t\t\t\t\t\t\t<h4 class=\"month2 mbr-black mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-2\" data-app-selector=\".month2, .plan-header\">Ετήσια</h4>\n\t\t\t\t\t\t\t<span class=\"mbr-iconfont pt-3 pb-2 icon mdi-image-filter-9-plus\" mbr-icon style=\"color: rgb(255, 255, 255); fill: rgb(255, 255, 255);\"></span>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"plan-body card2\">\n\t\t\t\t\t\t\t<div class=\"plan-list\" mbr-list mbr-list-grow=\"items2Count\" mbr-if=\"items2Count > 0\">\n\t\t\t\t\t\t\t\t<div class=\"plan-item d-flex justify-content-center\">\n\t\t\t\t\t\t\t\t\t<span class=\"mbr-iconfont mobi-mbri-success mobi-mbri\" mbr-icon style=\"color: rgb(255, 255, 255); fill: rgb(255, 255, 255);\"></span>\n\t\t\t\t\t\t\t\t\t<p class=\"item2 mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item2\">Λογισμικό PMS</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class=\"plan-item d-flex justify-content-center\">\n\t\t\t\t\t\t\t\t\t<span class=\"mbr-iconfont mobi-mbri-success mobi-mbri\" mbr-icon style=\"color: rgb(255, 255, 255); fill: rgb(255, 255, 255);\"></span>\n\t\t\t\t\t\t\t\t\t<p class=\"item2 mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item2\">All in One Channel manager (μέχρι 4 πόρταλ)<br></p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class=\"plan-item d-flex justify-content-center\">\n\t\t\t\t\t\t\t\t\t<span class=\"mbr-iconfont mobi-mbri-success mobi-mbri\" mbr-icon style=\"color: rgb(255, 255, 255); fill: rgb(255, 255, 255);\"></span>\n\t\t\t\t\t\t\t\t\t<p class=\"item2 mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item2\">Booking engine για ιστοσελίδα (3% προμήθεια)<br></p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class=\"plan-item d-flex justify-content-center\">\n\t\t\t\t\t\t\t\t\t<span class=\"mbr-iconfont mobi-mbri-success mobi-mbri\" mbr-icon style=\"color: rgb(255, 255, 255); fill: rgb(255, 255, 255);\"></span>\n\t\t\t\t\t\t\t\t\t<p class=\"item2 mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item2\">ΔΩΡΕΑΝ σύνδεση με myDATA<br></p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"plan-price\">\n\t\t\t\t\t\t\t\t<span mbr-text class=\"price-value2 mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".price-value2, .plan-price\">€</span>\n\t\t\t\t\t\t\t\t<span mbr-text class=\"price-figure2 mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-2\" data-app-selector=\".price-figure2, .plan-price\">600</span>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\n\t\t\t\t\t<div class=\"plan col-12 justify-content-center\" mbr-if=\"itemsCount > 2\" mbr-class=\"{\n                        'col-lg-3': itemsCount == 3,\n                        'col-lg-6': itemsCount == 2}\">\n\t\t\t\t\t\t<div class=\"plan-header card1\">\n\t\t\t\t\t\t\t<h3 class=\"plan-title mbr-black mbr-bold pb-1 mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".plan-title\">ALL IΝ ONE<br>(ελάχιστη διάρκεια 6 μήνες μέχρι)</h3>\n\t\t\t\t\t\t\t<h4 class=\"month mbr-black mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-2\" data-app-selector=\".month, .plan-header\">Μήνα</h4>\n\t\t\t\t\t\t\t<span class=\"mbr-iconfont pt-3 pb-2 icon mdi-image-filter-6\" mbr-icon></span>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"plan-body card1\">\n\t\t\t\t\t\t\t<div class=\"plan-list\" mbr-list mbr-list-grow=\"items3Count\" mbr-if=\"items3Count > 0\">\n\t\t\t\t\t\t\t\t<div class=\"plan-item d-flex justify-content-center\">\n\t\t\t\t\t\t\t\t\t<span class=\"mbr-iconfont mobi-mbri-success mobi-mbri\" mbr-icon style=\"color: rgb(239, 83, 17); fill: rgb(239, 83, 17);\"></span>\n\t\t\t\t\t\t\t\t\t<p class=\"mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".plan-item p, .plan-item .mbr-iconfont\">Λογισμικό PMS</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class=\"plan-item d-flex justify-content-center\">\n\t\t\t\t\t\t\t\t\t<span class=\"mbr-iconfont mobi-mbri-success mobi-mbri\" mbr-icon style=\"color: rgb(239, 83, 17); fill: rgb(239, 83, 17);\"></span>\n\t\t\t\t\t\t\t\t\t<p class=\"mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".plan-item p, .plan-item .mbr-iconfont\">All in One Channel manager (μέχρι 4 πόρταλ)<br></p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class=\"plan-item d-flex justify-content-center\">\n\t\t\t\t\t\t\t\t\t<span class=\"mbr-iconfont mobi-mbri-success mobi-mbri\" mbr-icon style=\"color: rgb(239, 83, 17); fill: rgb(239, 83, 17);\"></span>\n\t\t\t\t\t\t\t\t\t<p class=\"mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".plan-item p, .plan-item .mbr-iconfont\">Booking engine για ιστοσελίδα (3% προμήθεια)<br></p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class=\"plan-item d-flex justify-content-center\">\n\t\t\t\t\t\t\t\t\t<span class=\"mbr-iconfont mobi-mbri-success mobi-mbri\" mbr-icon style=\"color: rgb(239, 83, 17); fill: rgb(239, 83, 17);\"></span>\n\t\t\t\t\t\t\t\t\t<p class=\"mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".plan-item p, .plan-item .mbr-iconfont\">ΔΩΡΕΑΝ σύνδεση με myDATA<br></p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"plan-price\">\n\t\t\t\t\t\t\t\t<span mbr-text class=\"price-value mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".price-value, .plan-price\">€</span>\n\t\t\t\t\t\t\t\t<span mbr-text class=\"price-figure mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-2\" data-app-selector=\".price-figure, .plan-price\">60&nbsp;</span>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</section>",
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "& when (@bg-type = 'color')": {
              "background": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".price-term": {
              "vertical-align": "top"
            },
            "@media (min-width: 1200px)": {
              ".container": {
                "max-width": "1300px",
                "padding": "0 2rem"
              }
            },
