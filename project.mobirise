              },
              ".btn-primary": {
                "&:hover": {
                  "background-color": "#222222 !important",
                  "border-color": "#222222 !important",
                  "span": {
                    "color": "@primaryColor !important"
                  }
                }
              },
              "overflow": "hidden",
              "@media (min-width: 768px)": {
                "&:hover": {
                  "& img": {
                    "transform": "scale(1)"
                  }
                }
              }
            },
            ".item-img": {
              "position": "absolute",
              "top": "0",
              "left": "0",
              "width": "100%",
              "height": "100%",
              "overflow": "hidden",
              "& img": {
                "width": "100%",
                "transform": "scale(1.2)",
                "transform-style": "preserve-3d",
                "transition": "2s"
              }
            },
            ".img-overlay": {
              "position": "absolute",
              "top": "0",
              "width": "100%",
              "height": "100%",
              "background-color": "#000000",
              "opacity": "0.2",
              "pointer-events": "none"
            },
            ".item-content": {
              "position": "relative",
              "z-index": "3",
              "padding": "0"
            },
            ".mbr-section-title": {
              "color": "#222222",
              "width": "100%"
            },
            ".mbr-text": {
              "color": "#ffffff"
            },
            ".item-title": {
              "color": "#ffffff",
              "text-align": "left"
            },
            ".item-subtitle": {
              "color": "#ffffff",
              "text-align": "center"
            },
            ".icon-wrapper": {
              "margin-bottom": "1rem",
              ".mbr-iconfont": {
                "font-size": "33px",
                "color": "@iconColor"
              }
            },
            ".mbr-section-head": {
              "display": "flex",
              "flex-direction": "column",
              "justify-content": "flex-end",
              "margin-bottom": "4rem",
              "@media (min-width: 992px)": {
                "padding-left": "30px",
                "padding-right": "6rem",
                "margin-bottom": "2rem"
              }
            }
