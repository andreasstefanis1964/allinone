          "_name": "afeatures1",
          "_sourceTheme": "structurem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features1 structurem5\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\" plugins=\"mobirise-icons2\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Border\" name=\"showBorder\" checked>\n        <input type=\"color\" title=\"Border Color\" name=\"borderColor\" value=\"#fcdb42\" condition=\"showBorder\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"List\" name=\"showList\" checked>\n        <input type=\"range\" inline title=\"List Count\" name=\"listCount\" min=\"1\" max=\"6\" step=\"1\" value=\"6\" condition=\"showList\">\n        <input type=\"checkbox\" title=\"Icons\" name=\"showIcon\" checked condition=\"showList\">\n        <input type=\"color\" title=\"Icon Color\" name=\"iconColor\" value=\"#090f10\" selected condition=\"showList && showIcon\">\n        <input type=\"color\" title=\"Icon Bg Color\" name=\"iconBgColor\" value=\"#ef5311\" selected condition=\"showList && showIcon\">\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value parallax>\n            <input type=\"color\" title=\"Color\" value=\"#090f10\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#090f10\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div class=\"section-border-item section-border-item_top\" mbr-if=\"showBorder\"></div>\n    <div class=\"section-border-item section-border-item_center\" mbr-if=\"showBorder\"></div>\n    <div class=\"section-border-item section-border-item_bottom\" mbr-if=\"showBorder\"></div>\n    <div mbr-class=\"{'container-fluid':fullWidth, container:fullWidth==false}\">\n        <div class=\"main-container\">\n            <div class=\"card-wrap\">\n                <div class=\"card-box\" mbr-if=\"showTitle || showText || showList || showButtons\">\n                    <h4 class=\"card-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">Online Συνδρομές FLEX για&nbsp; διαχειριστές πολλαπλών τουριστικών καταλυμάτων σε διαφορετικές διευθύνσεις (με Online Deal -10%)</h4>\n                    <p class=\"mbr-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">\n                        Με την ολοκληρωμένη τεχνολογία All in One LIGHT μειώνετε τα κόστη, αυξάνετε τις κρατήσεις και διαχειρίζεστε με πανεύκολο τρόπο όλες τις κρατήσεις από όλες τις συσκευές σας. Εσείς επιλέγετε μόνο τον τρόπο που θέλετε να πληρώνετε την συνδρομή σας (FLAT ή FLEX, μηνιαία ή ετήσια).</p>\n                    <div class=\"counter-container\" mbr-if=\"showList\">\n                        <div class=\"list\">\n                            <div class=\"list-item\">\n                                <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                    <span mbr-icon class=\"mbr-iconfont mobi-mbri-success mobi-mbri\"></span>\n                                </div>\n                                <p class=\"list-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".list-text\">Έγκατάσταση (Setup)&nbsp;ανά ID με συνδέσεις (ΟΤΑ ή και ICAL)</p>\n                            </div>\n                            <div class=\"list-item\" mbr-if=\"listCount > 1\">\n                                <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                    <span mbr-icon class=\"mbr-iconfont mobi-mbri-success mobi-mbri\"></span>\n                                </div>\n                                <p class=\"list-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".list-text\">Cloud λογισμικό (PMS) και από κινητές συσκευές</p>\n                            </div>\n                            <div class=\"list-item\" mbr-if=\"listCount > 2\">\n                                <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                    <span mbr-icon class=\"mbr-iconfont mobi-mbri-success mobi-mbri\"></span>\n                                </div>\n                                <p class=\"list-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".list-text\">Ενσωματωμένος All in One Channel manager (2-way xml)</p>\n                            </div>\n                            <div class=\"list-item\" mbr-if=\"listCount > 3\">\n                                <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                    <span mbr-icon class=\"mbr-iconfont mobi-mbri-success mobi-mbri\"></span>\n                                </div>\n                                <p class=\"list-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".list-text\">ΔΩΡΕΑΝ σύνδεση με 4 πόρταλ (Booking, AirBnB, Expedia, ...)</p>\n                            </div>\n                            <div class=\"list-item\" mbr-if=\"listCount > 4\">\n                                <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                    <span mbr-icon class=\"mbr-iconfont mobi-mbri-success mobi-mbri\"></span>\n                                </div>\n                                <p class=\"list-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".list-text\">\n                                    ΔΩΡΕΑΝ μηχανή κρατήσεων με 3% προμήθεια\n                                </p>\n                            </div>\n                            <div class=\"list-item\" mbr-if=\"listCount > 5\">\n                                <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                    <span mbr-icon class=\"mbr-iconfont mobi-mbri-success mobi-mbri\"></span>\n                                </div>\n                                <p class=\"list-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".list-text\">ΔΩΡΕΑΝ σύνδεση με myDATA (ΑΑΔΕ)</p>\n                            </div>\n                        </div>\n                    </div>\n                    <div mbr-buttons mbr-theme-style=\"display-7\" class=\"mbr-section-btn mb-0\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-primary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                            <span class=\"mobi-mbri mobi-mbri-right mbr-iconfont mbr-iconfont-btn\"></span>\n                            Learn More About Our Services\n                        </a></div>\n                </div>\n            </div>\n            <div class=\"image-wrapper\">\n                <div class=\"img-box\">\n                    <img src=\"@PROJECT_PATH@/assets/images/1.dbl-partial-min.webp\" alt=\"Mobirise Website Builder\">\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
