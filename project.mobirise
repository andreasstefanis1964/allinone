        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "position": "relative",
            ".container, .container-fluid": {
              "position": "static"
            },
            ".mbr-section-title": {
              "margin-bottom": "25px",
              "color": "#131313",
              "@media (max-width: 1199px)": {
                "margin-bottom": "5px"
              }
            },
            ".mbr-section-subtitle": {
              "color": "#fc7942"
            },
            ".mbr-text": {
              "margin-top": "30px",
              "color": "#131313",
              "@media (max-width: 767px)": {
                "margin-top": "18px"
              }
            },
            ".mbr-section-btn": {
              "margin-top": "20px",
              "@media (max-width: 767px)": {
                "margin-top": "15px"
              }
            },
            ".item-img": {
              "position": "absolute",
              "top": "0",
              "right": "0",
              "height": "100%",
              "width": "42%",
              "display": "flex",
              "justify-content": "center",
              "align-items": "center",
              "padding": "0 !important",
              "& when (@reverseContent)": {
                "right": "auto",
                "left": "0"
              },
              "img": {
                "height": "100%",
                "width": "100%",
                "object-fit": "cover"
              },
              "@media (max-width: 1199px)": {
                "display": "none"
              }
            }
          },
          "_name": "aheader2",
          "_sourceTheme": "calmm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"header2 calmm5\" group=\"Headers\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#e2ecf4\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#f5db6e\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.1\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div class mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\" mbr-class=\"{'justify-content-start': !reverseContent, 'justify-content-end': reverseContent}\">\n            <div class=\"col-12 col-xl-6\">\n                <h1 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-4\" mbr-if=\"showTitle\">ΑΥΞΗΣΗ ΡΕΥΣΤΟΤΗΤΑΣ ΜΕΣΩ ΠΡΟΠΩΛΗΣΕΩΝ ΜΕ ΚΟΥΠΟΝΙΑ</h1>\n                <h2 class=\"mbr-section-subtitle mbr-fonts-style mb-0\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-2\" mbr-if=\"showSubtitle\">\n                    <b>Πουλήστε με προκαταβολή μέσω Vouchers</b></h2>\n                <p class=\"mbr-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">\n                    Πουλήστε κουπόνια από τη σελίδα κράτησής σας — ένα νέο κανάλι εσόδων με προκαταβολή μετρητών. Τα δωροκουπόνια έχουν μια αξία που ξοδεύουν οι επισκέπτες σε μια κράτηση. Τα πακέτα διαμονής (π.χ. «Απόδραση Σαββατοκύριακου — 2 διανυκτερεύσεις για 2 άτομα») αγοράζονται τώρα και κρατούνται online αργότερα σύμφωνα με τους κανόνες σας: ποιά δωμάτια, ποιές ημερομηνίες, ποιές ημέρες check-in.</p>\n                <div mbr-buttons mbr-theme-style=\"display-7\" class=\"mbr-section-btn\" mbr-if=\"showButtons\">\n                    <a class=\"btn btn-secondary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                        GET STARTED\n                    </a>\n                </div>\n            </div>\n        </div>\n        <div class=\"item-img\">\n            <img src=\"@PROJECT_PATH@/assets/images/bildschirmfoto-2026-07-19-um-16.23.14.webp\" alt>\n        </div>\n    </div>\n</section>",
