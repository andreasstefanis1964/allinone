                "width": "100%",
                "object-fit": "cover"
              }
            }
          },
          "_name": "afeatures1",
          "_sourceTheme": "structurem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features1 structurem5\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\" plugins=\"mobirise-icons2\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Border\" name=\"showBorder\" checked>\n        <input type=\"color\" title=\"Border Color\" name=\"borderColor\" value=\"#fcdb42\" condition=\"showBorder\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"List\" name=\"showList\" checked>\n        <input type=\"range\" inline title=\"List Count\" name=\"listCount\" min=\"1\" max=\"6\" step=\"1\" value=\"6\" condition=\"showList\">\n        <input type=\"checkbox\" title=\"Icons\" name=\"showIcon\" checked condition=\"showList\">\n        <input type=\"color\" title=\"Icon Color\" name=\"iconColor\" value=\"#090f10\" selected condition=\"showList && showIcon\">\n        <input type=\"color\" title=\"Icon Bg Color\" name=\"iconBgColor\" value=\"#ef5311\" selected condition=\"showList && showIcon\">\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value parallax selected>\n            <input type=\"color\" title=\"Color\" value=\"#090f10\">\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#090f10\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div class=\"section-border-item section-border-item_top\" mbr-if=\"showBorder\"></div>\n    <div class=\"section-border-item section-border-item_center\" mbr-if=\"showBorder\"></div>\n    <div class=\"section-border-item section-border-item_bottom\" mbr-if=\"showBorder\"></div>\n    <div mbr-class=\"{'container-fluid':fullWidth, container:fullWidth==false}\">\n        <div class=\"main-container\">\n            <div class=\"card-wrap\">\n                <div class=\"card-box\" mbr-if=\"showTitle || showText || showList || showButtons\">\n                    <h4 class=\"card-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">Online Συνδρομές FLAT για <b>μικρά</b> ξενοδοχεία <b>μέχρι 7 δωμάτια</b> με Online Deal -10%</h4>\n                    <p class=\"mbr-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">Με την ολοκληρωμένη τεχνολογία All in One LIGHT μειώνετε τα κόστη, αυξάνετε τις κρατήσεις και διαχειρίζεστε με πανεύκολο τρόπο όλες τις κρατήσεις από όλες τις συσκευές σας. Εσείς επιλέγετε μόνο τον τρόπο που θέλετε να πληρώνετε την συνδρομή σας (FLAT, μηνιαία ή ετήσια).</p>\n                    <div class=\"counter-container\" mbr-if=\"showList\">\n                        <div class=\"list\">\n                            <div class=\"list-item\">\n                                <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                    <span mbr-icon class=\"mbr-iconfont mobi-mbri-success mobi-mbri\"></span>\n                                </div>\n                                <p class=\"list-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".list-text\">ΔΩΡΕΑΝ εγκατάσταση (Setup)</p>\n                            </div>\n                            <div class=\"list-item\" mbr-if=\"listCount > 1\">\n                                <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                    <span mbr-icon class=\"mbr-iconfont mobi-mbri-success mobi-mbri\"></span>\n                                </div>\n                                <p class=\"list-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".list-text\">Cloud ξενοδοχειακό λογισμικό (PMS) και από κινητές συσκευές</p>\n                            </div>\n                            <div class=\"list-item\" mbr-if=\"listCount > 2\">\n                                <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                    <span mbr-icon class=\"mbr-iconfont mobi-mbri-success mobi-mbri\"></span>\n                                </div>\n                                <p class=\"list-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".list-text\">Ενσωματωμένος All in One Channel manager (2-way xml)</p>\n                            </div>\n                            <div class=\"list-item\" mbr-if=\"listCount > 3\">\n                                <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                    <span mbr-icon class=\"mbr-iconfont mobi-mbri-success mobi-mbri\"></span>\n                                </div>\n                                <p class=\"list-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".list-text\">ΔΩΡΕΑΝ σύνδεση με 4 πόρταλ (Booking, AirBnB, Expedia, ...)</p>\n                            </div>\n                            <div class=\"list-item\" mbr-if=\"listCount > 4\">\n                                <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                    <span mbr-icon class=\"mbr-iconfont mobi-mbri-success mobi-mbri\"></span>\n                                </div>\n                                <p class=\"list-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".list-text\">\n                                    ΔΩΡΕΑΝ μηχανή κρατήσεων με 0% προμήθεια\n                                </p>\n                            </div>\n                            <div class=\"list-item\" mbr-if=\"listCount > 5\">\n                                <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                    <span mbr-icon class=\"mbr-iconfont mobi-mbri-success mobi-mbri\"></span>\n                                </div>\n                                <p class=\"list-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".list-text\">ΔΩΡΕΑΝ σύνδεση με myDATA (ΑΑΔΕ)</p>\n                            </div>\n                        </div>\n                    </div>\n                    <div mbr-buttons mbr-theme-style=\"display-7\" class=\"mbr-section-btn mb-0\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-primary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                            <span class=\"mobi-mbri mobi-mbri-right mbr-iconfont mbr-iconfont-btn\"></span>\n                            Learn More About Our Services\n                        </a></div>\n                </div>\n            </div>\n            <div class=\"image-wrapper\">\n                <div class=\"img-box\">\n                    <img src=\"@PROJECT_PATH@/assets/images/arsenis-villas-97-min-1216x1824.webp\" alt=\"Mobirise Website Builder\">\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_anchor": "afeatures1-53",
          "_isUserblock": true,
          "_cid": "u2X2HXrZVl",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "tabs02",
          "_sourceTheme": "politicsm4",
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "& when (@bg-type = 'color')": {
              "background": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".list-group-item": {
              "padding": "0.5rem 3.25rem"
            },
            "h4": {
              "margin": "0"
            },
            ".plan-body .mbr-section-btn .btn-sm": {
              "padding": "0.6rem 4.4rem"
            },
            ".plan-body": {
              "padding-bottom": "2rem"
            },
            ".plan-header": {
              "padding-top": "2rem",
              "padding-left": "1rem",
              "padding-right": "1rem"
            },
            ".nav-tabs": {
              "border": "none !important",
              ".nav-item": {
                "margin": "0"
              },
              ".btn": {
                "&:not(:focus):not(:hover):not(.active) when (@showStyles)": {
                  "color": "@tabsColor !important"
                },
                "transition": "all 0.5s",
                "border": "none !important",
                "padding-top": "0.6rem",
                "padding-bottom": "0.6rem",
                "box-shadow": "0 0 15px 0 rgba(0, 0, 0, 0.1)",
                "&:after": {
                  "display": "none"
                },
                "& when (@showStyles)": {
                  "background": "transparent !important",
                  "&.active, &:hover": {
                    "background": "@tabsBg !important",
                    "color": "contrast(@tabsBg) !important"
                  }
                }
              },
              "@media (min-width: 768px)": {
                ".btn": {
                  "margin": "0px !important"
                },
                ".nav-item:first-child .btn": {
                  "border-top-right-radius": "0 !important",
                  "border-bottom-right-radius": "0 !important"
                },
                ".nav-item:last-child .btn": {
                  "border-top-left-radius": "0 !important",
                  "border-bottom-left-radius": "0 !important"
                }
              }
            },
            ".line": {
              "width": "35px",
              "height": "3px",
              "display": "inline-block",
              "background": "@lineColor",
              "transition": "background 0.3s",
              "margin-bottom": "1.5rem"
            },
            ".line2": {
              "background": "@lineColor2"
            },
            ".plan": {
              "word-break": "break-word",
              "box-shadow": "0 0 15px 0 rgba(0, 0, 0, 0.1)",
              "position": "relative",
              "padding-right": "0",
              "padding-left": "0",
              ".list-group-item": {
                "position": "relative",
                "-webkit-justify-content": "center",
                "justify-content": "center",
                "border": "0",
                "&::after": {
                  "position": "absolute",
                  "bottom": "0",
                  "left": "20%",
                  "width": "60%",
                  "height": "2px",
                  "content": "''",
                  "background-color": "#eaeaea"
                },
                "&:last-child::after": {
                  "display": "none"
                }
              }
            },
            ".plan-header, .plan-body": {
              "background-color": "#fff"
            },
            ".price-figure": {
              "font-weight": "700"
            },
            ".price-value": {
              "font-weight": "700",
              "vertical-align": "top"
            },
            "@media (max-width: 550px)": {
              ".price-figure": {
                "font-size": "4.25rem"
              }
            },
            ".color1": {
              "color": "#255085"
            },
            ".color2": {
              "color": "#ed4266"
            },
            "LI": {
              "color": "#767676"
            },
            ".price-term": {
              "color": "#767676"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            }
          },
