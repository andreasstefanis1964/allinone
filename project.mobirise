            },
            ".image-wrapper": {
              "flex-shrink": "0",
              "width": "80px",
              "height": "80px",
              "margin-right": "130px",
              "overflow": "hidden",
              "@media (max-width: 1024px)": {
                "margin-right": "30px"
              },
              "@media (max-width: 767px)": {
                "margin-right": "20px"
              },
              "img": {
                "width": "100%",
                "height": "100%",
                "object-fit": "cover"
              }
            },
            ".card-title": {
              "color": "#131313"
            },
            ".card-subtitle": {
              "color": "#FC7942"
            },
            ".card-text": {
              "margin-right": "175px",
              "margin-top": "5px",
              "color": "#131313",
              "@media (max-width: 1024px)": {
                "margin-right": "30px"
              },
              "@media (max-width: 767px)": {
                "margin-right": "10px"
              },
              "@media (max-width: 575px)": {
                "margin-right": "0"
              }
            },
            ".iconfont-wrapper": {
              "margin-left": "auto",
              "@media (max-width: 575px)": {
                "display": "none"
              },
              ".mbr-iconfont": {
                "display": "block",
                "font-size": "50px",
                "color": "@iconColor",
                "transform": "rotate(-45deg)",
                "transition": "0.3s all"
              }
            },
            "@media (min-width: 992px)": {
              ".card-wrapper": {
                "&:hover": {
                  ".iconfont-wrapper": {
                    ".mbr-iconfont": {
                      "transform": "rotate(0)"
                    }
                  }
                }
              }
            }
