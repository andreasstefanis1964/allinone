          "_name": "afeatures3",
          "_sourceTheme": "calmm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features3 calmm5\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"List\" name=\"showList\" checked>\n        <input type=\"range\" inline title=\"List Count\" name=\"listCount\" min=\"1\" max=\"6\" step=\"1\" value=\"6\" condition=\"showList\">\n        <input type=\"checkbox\" title=\"Icons\" name=\"showIcon\" checked condition=\"showList\">\n        <input type=\"color\" title=\"Icon Color\" name=\"iconColor\" value=\"#FC7942\" condition=\"showIcon && showList\">\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background3.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#e2ecf4\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background3.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container-small': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row align-items-center justify-content-center\">\n            <div class=\"item-img\">\n                <img src=\"@PROJECT_PATH@/assets/images/bildschirmfoto-2026-07-19-um-16.29.21.webp\" alt>\n            </div>\n            <div class=\"item-content\" mbr-if=\"showTitle || showList || showText || showButtons\">\n                <h5 class=\"card-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".card-title\"><b>Aύξηση κρατήσεων&nbsp;</b></h5>\n                <p class=\"card-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text, .mbr-section-btn\">Ο επισκέπτης κάνει κράτηση έχοντας πολλές επιλογές τιμών ανάλογα με τις πολιτικές ακυρωτικών, και βέβαια ανάλογα το budget που διαθέτει. Η παρουσίαση του καταλύματος γίνεται με τέτοιο τρόπο, ώστε να προτιμήσει να κάνει την κράτηση απευθείας, απ΄ότι μέσω τοων πόρταλ.<br><br><b>Πλεονεκτήματα για τον ξενοδόχο, διαχειριστή κρατήσεων:</b><br><br><i><b>1. Δωρεάν εγκατάσταση (Setup).&nbsp;</b><br><b>2. Πανεύκολη Διαχείριση του λογισμικού με άμεση διαμόρφωση προσφορών, Extras, vouchers</b></i><br><i><b>3. Προβολή της μηχανής κρατήσεων στην Google και σε γερμανόφωνα πελατολόγια μέσω του ela-greece, κοινωνικών δικτύων, και newsletters&nbsp;</b><br><b>4. Προσαρμογή στα εικαστικά του καταλύματος και της ιστοσελίδας με Brand Kit εργαλεία</b></i><br></p>\n                <div class=\"list-box\" mbr-if=\"showList\">\n                    <div class=\"list-item\">\n                        <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-right mobi-mbri\"></span>\n                        </div>\n                        <p class=\"list-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".list-text\"><b>Σύνδεση με τον All in One Channel manager</b></p>\n                    </div>\n                    <div class=\"list-item\" mbr-if=\"listCount > 1\">\n                        <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-right mobi-mbri\"></span>\n                        </div>\n                        <p class=\"list-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".list-text\"><b>Online πληρωμές μέσω καρτών (Stripe 1,5%) κλπ.&nbsp;</b></p>\n                    </div>\n                    <div class=\"list-item\" mbr-if=\"listCount > 2\">\n                        <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-right mobi-mbri\"></span>\n                        </div>\n                        <p class=\"list-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".list-text\">\n                            <b>Προώθηση στην Google με νέο αλγόριθμο</b><br></p>\n                    </div>\n                    <div class=\"list-item\" mbr-if=\"listCount > 3\">\n                        <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-right mobi-mbri\"></span>\n                        </div>\n                        <p class=\"list-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".list-text\"><b>Αυτόνομη διαχείριση κρατήσεων από τους πελάτες σας</b></p>\n                    </div>\n                    <div class=\"list-item\" mbr-if=\"listCount > 4\">\n                        <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-right mobi-mbri\"></span>\n                        </div>\n                        <p class=\"list-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".list-text\"><b>Πολύγλωσση: Αγγλικά, Ελληνικά, Γερμανικά, Ιταλικά,...</b><br></p>\n                    </div>\n                    <div class=\"list-item\" mbr-if=\"listCount > 5\">\n                        <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-right mobi-mbri\"></span>\n                        </div>\n                        <p class=\"list-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".list-text\">\n                            <b>Πωλήσεις Extras, Vouchers, Promotions</b><b><br></b></p>\n                    </div>\n                </div>\n\n                <div class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-7\"><a href=\"mbrext://smart-cart?cmdsm=_cart&amount=20.00&item_name=RENT%20A%20WEBSITE%20MONTHLY&currency_code=EUR&dataShop=smartCart\" class=\"btn btn-danger\" data-app-placeholder=\"Type Text\">Προμήθεια: 5%*<br></a></div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "vpPpLjaon3",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {},
          "_anchor": "afeatures3-as"
